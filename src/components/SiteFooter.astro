---
import { WA, PRICES_CHECKED } from '../config/prices.js';
const guides = [
  ['QuickBooks Online', '/quickbooks-online'],
  ['QuickBooks Desktop', '/quickbooks-desktop'],
  ['Excel', '/excel'],
  ['Zoho Books', '/zoho-books'],
  ['Tally', '/tally'],
  ['Wafeq', '/wafeq'],
  ['Other software', '/other-software'],
];
const waHref = `https://wa.me/${WA}`;
---

<footer class="sitefoot">
  <div class="sf-grid">
    <section class="sf-about">
      <h2>Einvoice Cost</h2>
      <p>We help UAE businesses understand and set up e-invoicing. Every price is shown upfront for your exact invoice count, with no slabs or brackets. We handle setup for QuickBooks, Excel and other software, from our office in Business Bay, Dubai.</p>
      <a class="sf-wa" href={waHref} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp us</a>
    </section>
    <nav class="sf-col" aria-label="Software guides">
      <h3>Guides</h3>
      <ul>{guides.map(([name, href]) => <li><a href={href}>{name}</a></li>)}</ul>
    </nav>
    <nav class="sf-col" aria-label="Insights and tools">
      <h3>Insights</h3>
      <ul>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/">E-invoice calculator</a></li>
        <li><a href="/switch-accounting-software">Switch software</a></li>
      </ul>
    </nav>
    <section class="sf-legal">
      <h3>Compliance &amp; Legal Notice</h3>
      <p>Content is for informational purposes and aligns with UAE Ministry of Finance (MoF) and Federal Tax Authority (FTA) guidelines under Cabinet Decision No. 173 of 2026. This site is not an official government portal.</p>
    </section>
  </div>
  <p class="sf-base">einvoicecost.ae · Prices checked: {PRICES_CHECKED}</p>
</footer>

<style is:global>
  .sitefoot{margin-top:48px;background:var(--navy,#12305A);color:#C9D6E8;border-radius:6px;padding:32px 28px 20px;font-size:14px;line-height:1.6;display:block}
  .sitefoot h2{font-family:var(--serif,Georgia,serif);font-size:22px;color:#fff;border:0;padding:0;margin:0 0 10px}
  .sitefoot h3{font-family:var(--sans,inherit);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:#fff;margin:0 0 10px;font-weight:700}
  .sitefoot p{margin:0}
  .sitefoot a{color:#fff;text-decoration:none}
  .sitefoot a:hover{text-decoration:underline}
  .sf-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.5fr;gap:28px}
  .sitefoot ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
  .sf-wa{display:inline-flex;align-items:center;gap:8px;margin-top:14px;background:#128C4A;color:#fff!important;font-weight:700;padding:10px 16px;border-radius:6px}
  .sf-wa:hover{text-decoration:none!important;filter:brightness(1.1)}
  .sf-legal p{font-size:13px;color:#C9D6E8}
  .sf-base{margin-top:24px!important;padding-top:14px;border-top:1px solid rgba(255,255,255,.18);font-size:12px;color:#9CC2F0}
  @media(max-width:900px){.sf-grid{grid-template-columns:1fr 1fr}.sf-about,.sf-legal{grid-column:1/-1}}
  @media(max-width:520px){.sf-grid{grid-template-columns:1fr}.sitefoot{padding:24px 18px 16px}}
</style>
