---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guide.css';
import PriceBox from '../components/PriceBox.astro';
import PriceTable from '../components/PriceTable.astro';
import { PRICES, PRICES_CHECKED, fmt, aed, invoiceFee, firstYearText, everyYearText, connectorText } from '../config/prices.js';

const title = "Zoho Books E-Invoicing UAE: Cost, Packs & Setup";
const description = `Zoho Books is its own UAE e-invoicing ASP. Pack prices (1,000 = AED 330), the plan you need and 5 setup steps. DIY free, or we do it for ${aed(PRICES.help)}.`;
const faqs = [
  {
    "q": "Is Zoho Books an accredited service provider (ASP) in the UAE?",
    "a": "Yes. Zoho is an ASP through Zoho Software Trading LLC, so Zoho Books users appoint Zoho on EmaraTax and do not need another provider."
  },
  {
    "q": "Is Zoho Books e-invoicing free?",
    "a": "Not fully. The first 100 e-invoicing transactions are free, once. After that you buy one-time packs, for example AED 330 for 1,000 transactions. There is no ASP fee, connector or platform fee from us."
  },
  {
    "q": "Which Zoho Books plan do I need for e-invoicing?",
    "a": "Professional or higher. Professional costs AED 90 a month on yearly billing, which is AED 1,080 a year. The Free and Standard plans do not include e-invoicing."
  },
  {
    "q": "How much do Zoho e-invoicing packs cost?",
    "a": "100 transactions cost AED 41, 500 cost AED 185, 1,000 cost AED 330, 5,000 cost AED 1,500 and 10,000 cost AED 2,700. Packs are one-time purchases."
  },
  {
    "q": "Do Zoho e-invoicing packs expire?",
    "a": "Zoho partner material says unused transactions stay valid as long as your Zoho organisation stays the same. Confirm with Zoho for your account."
  },
  {
    "q": "How do I set up e-invoicing in Zoho Books?",
    "a": "Enter your details in Settings, E-Invoicing, select Zoho Software Trading LLC as your ASP on EmaraTax, then click Verify & Complete Setup in Zoho Books. The five steps on this page explain each one."
  },
  {
    "q": "Can I edit a Zoho invoice after it is sent?",
    "a": "No. Once an e-invoice is pushed, it cannot be edited or deleted. Issue a credit note instead."
  },
  {
    "q": "Can you set up Zoho e-invoicing for me?",
    "a": `Yes. We handle the full setup for ${aed(PRICES.help)} one time, including data clean-up, registration, testing and fixing any rejected invoice.`
  },
  {
    "q": "Can you move my data from QuickBooks or Excel to Zoho Books?",
    "a": "Yes. We move your customers, suppliers, items, chart of accounts, opening balances and unpaid invoices, then set up e-invoicing. See how switching works on our switch software page.",
    "html": 'Yes. We move your customers, suppliers, items, chart of accounts, opening balances and unpaid invoices, then set up e-invoicing. <a href="/switch-accounting-software">See how switching works</a>.'
  },
  {
    "q": "What is the e-invoicing deadline for Zoho Books users?",
    "a": "The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month."
  }
];
const breadcrumbs = [
  {
    "name": "Home",
    "url": "https://einvoicecost.ae/"
  },
  {
    "name": "Zoho Books",
    "url": "https://einvoicecost.ae/zoho-books"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://einvoicecost.ae/zoho-books"
  ogType="article"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" id="topWa" href="https://wa.me/971508759256" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel">Excel</a><a href="/zoho-books" aria-current="page">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq">Wafeq</a><a href="/other-software">Other software</a><a href="/switch-accounting-software">Switch software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › Zoho Books</p>
      <p class="eyebrow">Zoho Books · UAE e-invoicing guide</p>
      <h1>Zoho Books e-invoicing in the UAE: cost and setup</h1>
      <div class="answer">
        <p class="eyebrow">Quick answer</p>
        <p>Zoho Books is an <b>accredited ASP itself</b> (Zoho Software Trading LLC), so you don't need another provider. You need the <b>Professional plan or higher</b> and e-invoicing packs from Zoho.</p><p>There is <b>no ASP fee, no connector and no platform fee</b>. Set it up yourself for free in 5 steps, or we do it for <b>{aed(PRICES.help)} one time</b>.</p>
        <div class="facts"><div><p class="k">Zoho is an ASP</p><p class="v">Yes</p></div><div><p class="k">Plan needed</p><p class="v">Professional+</p></div><div><p class="k">Do it yourself</p><p class="v">Free</p></div></div>
      </div>
    </div>
  </div>
  <main class="wrap">
  
    <section id="cost">
      <h2>How much does Zoho Books e-invoicing cost in the UAE?</h2>
      <p class="sub">Zoho Books is its own ASP, so there is <b>no ASP fee, no connector and no platform fee</b>. You pay Zoho for e-invoicing packs, and you need the Professional plan or higher. The first 100 e-invoicing transactions are free, once. Set it up yourself for free, or we do it for <b>{aed(PRICES.help)} one time</b>.</p>
      <PriceBox sw="zoho" />
      <p class="small"><a href="/blog/uae-e-invoicing-cost#formula">See how the price is calculated →</a></p>
      <p class="small">Pack cost is approximate, based on Zoho's pack prices. Your Zoho Books plan is extra: Professional costs AED 1,080 a year on yearly billing.</p>
      <h3 class="sm">What you pay Zoho</h3>
      <h3 class="sm">Zoho e-invoicing pack prices (one-time, paid to Zoho)</h3>
      <div class="tablewrap"><table class="narrow"><thead><tr><th>Pack size</th><th>Price AED</th><th>Per transaction</th></tr></thead><tbody>
        <tr><td>First 100</td><td>Free</td><td>Once only</td></tr>
        <tr><td>100</td><td>41</td><td>0.41</td></tr><tr><td>500</td><td>185</td><td>0.37</td></tr><tr><td>1,000</td><td>330</td><td>0.33</td></tr>
        <tr><td>5,000</td><td>1,500</td><td>0.30</td></tr><tr><td>10,000</td><td>2,700</td><td>0.27</td></tr>
        <tr><td>50,000</td><td>11,500</td><td>0.23</td></tr><tr><td>100,000</td><td>20,000</td><td>0.20</td></tr></tbody></table></div>
      <h3 class="sm">Which Zoho Books plan includes e-invoicing?</h3>
      <div class="tablewrap"><table class="narrow"><thead><tr><th>Plan</th><th>AED / month<br>(yearly billing)</th><th>AED / month<br>(monthly billing)</th><th>E-invoicing</th></tr></thead><tbody>
        <tr><td>Free</td><td>0</td><td>0</td><td>No</td></tr><tr><td>Standard</td><td>60</td><td>69</td><td>No</td></tr>
        <tr><td>Professional</td><td>90</td><td>129</td><td>Yes</td></tr><tr><td>Premium</td><td>120</td><td>159</td><td>Yes</td></tr>
        <tr><td>Elite</td><td>280</td><td>349</td><td>Yes</td></tr><tr><td>Ultimate</td><td>660</td><td>799</td><td>Yes</td></tr></tbody></table></div>
    </section>
    <section id="steps">
      <h2>How to set up e-invoicing in Zoho Books yourself</h2>
      <div class="handle diy">
        <div class="handle-big">
          <span class="mode">Free · Do it yourself</span>
          <h3>Set it up yourself<br>in 5 steps.</h3>
          <p>Zoho Books is an accredited ASP itself, so you don't need another provider. Most businesses can set it up in a few hours with the steps below.</p>
        </div>
        <div class="handle-side">
          <h4>Or we handle it for you</h4>
          <p class="price">{aed(PRICES.help)}<small>one time</small></p>
          <ul><li>Your plan checked, so you don't pay for more than you need</li><li>Your customer TRNs, VAT codes and items checked and fixed</li><li>Registration and EmaraTax appointment done for you</li><li>A test invoice and credit note sent and checked</li><li>Rejected invoices fixed and your staff shown how it works</li></ul>
          <a class="btn-wa" id="helpWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> We'll do it for you</a>
        </div>
      </div>
      <ol class="steps5"><li><div><div class="st-head"><h3>Check your plan and data</h3><span class="tag you">You do it</span></div><p>Make sure you are on Zoho Books Professional or higher. Turn on taxes in Zoho Books and enter your TRN. Check that every business customer has a TRN and every item has a VAT code.</p></div></li><li><div><div class="st-head"><h3>Enter your details in Zoho Books</h3><span class="tag you">You do it</span></div><p>Go to Settings › E-Invoicing. Enter your business name, TIN, TRN, address and the email you use for EmaraTax, then accept the terms.</p></div></li><li><div><div class="st-head"><h3>Select Zoho as your ASP on EmaraTax</h3><span class="tag you">You do it</span></div><p>Log in to EmaraTax, choose your business, then E-Invoicing. Select "Zoho Software Trading LLC" as your ASP. On Zoho's page, enter your EmaraTax email and TIN, verify and submit.</p></div></li><li><div><div class="st-head"><h3>Complete the setup in Zoho</h3><span class="tag you">You do it</span></div><p>Go back to Zoho Books and click "Verify & Complete Setup". Your e-invoicing is now connected.</p></div></li><li><div><div class="st-head"><h3>Fix gaps and send a test</h3><span class="tag you">You do it</span></div><p>Zoho checks required fields, such as the customer's TRN, before it sends an invoice. Fix any missing details, then send one test invoice and one credit note and check they go through.</p></div></li></ol>
    </section>
    <section>
      <h2>How does e-invoicing work with Zoho Books?</h2>
      <ol class="flow"><li>You create the invoice in Zoho Books, as you do today.</li><li>Zoho Books, as your ASP, converts it to the UAE format (PINT AE) and checks it.</li><li>It is delivered through the Peppol network to your customer's ASP.</li><li>The invoice data is reported to the Federal Tax Authority (FTA).</li></ol>
    </section>
    <section>
      <h2>Things to know before you start</h2>
      <ul class="warn"><li><b>Sent invoices can't be edited.</b> Once an invoice is pushed, you cannot edit or delete it. Issue a credit note to correct it.</li><li><b>Supplier e-invoices arrive as draft bills.</b> Received e-invoices and vendor credits appear in Zoho Books as drafts for you to review.</li><li><b>Packs are one-time, not yearly.</b> Each pack is bought once and used up as you invoice. The first 100 transactions are free, once only.</li><li><b>Received bills may use transactions too.</b> Zoho partner material says received bills and credit notes also count. Confirm with Zoho for your account.</li><li><b>Free and Standard plans don't include e-invoicing.</b> You need Professional or higher.</li></ul>
      <p class="callout">Switching to Zoho Books from QuickBooks or Excel? <a href="/switch-accounting-software">We move your data →</a></p>
    </section>
    
    <section class="sources"><h2>Sources</h2><ul><li><a href="https://mof.gov.ae/en/about-us/initiatives/einvoicing/" target="_blank" rel="noopener">UAE Ministry of Finance: e-invoicing</a></li><li><a href="https://www.zoho.com/ae/books/pricing/" target="_blank" rel="noopener">Zoho Books UAE pricing</a></li></ul><p class="small">Prices and rules checked against these sources on {PRICES_CHECKED}. We update this page when they change.</p></section>
    <section>
      <h2>What is the e-invoicing deadline for Zoho Books users?</h2>
      <p class="sub">Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b> and go live on <b>1 July 2027</b>. The fine for appointing late is <b>AED 5,000 a month</b>. After go-live, each invoice not issued electronically can be fined AED 100, up to AED 5,000 a month. Businesses over AED 50 million had to appoint by 30 October 2026 and go live on 1 January 2027.</p>
    </section>
    <section>
      <h2>Zoho Books e-invoicing: common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.html ?? f.a} /></details>
        ))}
      </div>
    </section>
    <section class="final">
      <div><h2>Set it up yourself, or let us do it</h2><p class="sub">Stuck on a step, or rather not do it at all? Message us and we handle it for {aed(PRICES.help)}.</p></div>
      <a class="btn-wa" id="finalWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Ask us on WhatsApp</a>
    </section>
    <section>
      <h2>E-invoicing cost for other software</h2>
      <div class="more"><a href="/quickbooks-online">QuickBooks Online<span>Needs an ASP</span></a><a href="/quickbooks-desktop">QuickBooks Desktop<span>Needs an ASP</span></a><a href="/excel">Excel / no software<span>Needs an ASP</span></a><a href="/tally">Tally Prime<span>Built-in ASP</span></a><a href="/wafeq">Wafeq<span>Built-in ASP</span></a><a href="/other-software">Other software<span>Get a price</span></a><a href="/#compare">Compare all<span>Side by side</span></a></div>
    </section>
    <SiteFooter />
  </main>
  <div class="dock">
    <div class="row">
      <p class="fy cta" id="dockFy">Need e-invoice support?</p>
      <a class="btn-wa" id="dockWa" href="#" target="_blank" rel="noopener">WhatsApp Now</a>
    </div>
  </div>
  <script>
    import '../scripts/zoho-books.js';
  </script>
</BaseLayout>
