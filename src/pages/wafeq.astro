---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guide.css';
import PriceBox from '../components/PriceBox.astro';
import PriceTable from '../components/PriceTable.astro';
import { PRICES, PRICES_CHECKED, fmt, aed, invoiceFee, firstYearText, everyYearText, connectorText } from '../config/prices.js';

const title = "Wafeq E-Invoicing UAE: Is It Free? Plans & Setup";
const description = `Wafeq is its own UAE e-invoicing ASP and includes it in paid plans from AED 690 a year. Plans and 5 setup steps, or we do it for ${aed(PRICES.help)}.`;
const faqs = [
  {
    "q": "Is Wafeq e-invoicing free?",
    "a": "There is no extra charge. E-invoicing is included in Wafeq's paid plans: Starter (AED 690 a year), Plus (AED 960) and Premium (AED 2,400). There is no ASP fee, connector or platform fee from us."
  },
  {
    "q": "Is Wafeq an accredited service provider (ASP)?",
    "a": "Yes. Wafeq is an accredited ASP, so Wafeq users appoint Wafeq on EmaraTax and do not need another provider."
  },
  {
    "q": "Which Wafeq plan do I need for e-invoicing?",
    "a": "Any paid plan, starting with Starter at AED 690 a year. Choose by the features and limits you need."
  },
  {
    "q": "Wafeq or Zoho Books: which costs less for e-invoicing?",
    "a": "Wafeq includes e-invoicing in plans from AED 690 a year. Zoho Books needs the Professional plan (AED 1,080 a year) plus e-invoicing packs, for example AED 330 for 1,000 transactions."
  },
  {
    "q": "How do I set up e-invoicing in Wafeq?",
    "a": "Switch on e-invoicing in Wafeq, select Wafeq as your ASP on EmaraTax, then check the status shows Active. The five steps on this page explain each one."
  },
  {
    "q": "Can you set up Wafeq e-invoicing for me?",
    "a": `Yes. We handle the full setup for ${aed(PRICES.help)} one time, including data clean-up, registration, testing and any rejected invoice.`
  },
  {
    "q": "Can you move my data from QuickBooks or Excel to Wafeq?",
    "a": "Yes. We move your customers, suppliers, items, chart of accounts, opening balances and unpaid invoices, then set up e-invoicing. See how switching works on our switch software page.",
    "html": 'Yes. We move your customers, suppliers, items, chart of accounts, opening balances and unpaid invoices, then set up e-invoicing. <a href="/switch-accounting-software">See how switching works</a>.'
  },
  {
    "q": "What is the e-invoicing deadline for Wafeq users?",
    "a": "The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month."
  }
];
const breadcrumbs = [
  {
    "name": "Home",
    "url": "https://einvoicecost.ae/"
  },
  {
    "name": "Wafeq",
    "url": "https://einvoicecost.ae/wafeq"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://einvoicecost.ae/wafeq"
  ogType="article"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" id="topWa" href="https://wa.me/971508759256" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel">Excel</a><a href="/zoho-books">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq" aria-current="page">Wafeq</a><a href="/other-software">Other software</a><a href="/switch-accounting-software">Switch software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › Wafeq</p>
      <p class="eyebrow">Wafeq · UAE e-invoicing guide</p>
      <h1>Wafeq e-invoicing in the UAE: cost and setup</h1>
      <div class="answer">
        <p class="eyebrow">Quick answer</p>
        <p>Wafeq is an <b>accredited ASP itself</b>, so you don't need another provider. E-invoicing is <b>included at no extra cost</b> in its paid plans, from AED 690 a year.</p><p>There is <b>no ASP fee, no connector and no platform fee</b>. Set it up yourself for free in 5 steps, or we do it for <b>{aed(PRICES.help)} one time</b>.</p>
        <div class="facts"><div><p class="k">Wafeq is an ASP</p><p class="v">Yes</p></div><div><p class="k">E-invoicing fee</p><p class="v">AED 0</p></div><div><p class="k">Plans from</p><p class="v">AED 690/yr</p></div></div>
      </div>
    </div>
  </div>
  <main class="wrap">
  
    <section id="cost">
      <h2>How much does Wafeq e-invoicing cost in the UAE?</h2>
      <p class="sub">Wafeq is an accredited ASP itself, so there is <b>no ASP fee, no connector and no platform fee</b>. E-invoicing is included at no extra cost in its paid plans, so you pay only for the plan. Set it up yourself for free, or we do it for <b>{aed(PRICES.help)} one time</b>.</p>
      <PriceBox sw="wafeq" />
      <p class="small"><a href="/blog/uae-e-invoicing-cost#formula">See how the price is calculated →</a></p>
      <h3 class="sm">What you pay Wafeq</h3>
      <div class="tablewrap"><table class="narrow"><thead><tr><th>Wafeq plan</th><th>AED per year</th><th>E-invoicing</th></tr></thead><tbody>
        <tr><td>Starter</td><td>690</td><td>Included</td></tr>
        <tr><td>Plus</td><td>960</td><td>Included</td></tr>
        <tr><td>Premium</td><td>2,400</td><td>Included</td></tr>
      </tbody></table></div>
      <p class="small">Wafeq announced e-invoicing in all paid plans on 7 October 2026. Check Wafeq for current plan limits.</p>
    </section>
    <section id="steps">
      <h2>How to set up e-invoicing in Wafeq yourself</h2>
      <div class="handle diy">
        <div class="handle-big">
          <span class="mode">Free · Do it yourself</span>
          <h3>Set it up yourself<br>in 5 steps.</h3>
          <p>Wafeq is an accredited ASP itself, so you don't need another provider. Most businesses finish the setup in a day.</p>
        </div>
        <div class="handle-side">
          <h4>Or we handle it for you</h4>
          <p class="price">{aed(PRICES.help)}<small>one time</small></p>
          <ul><li>Your plan checked against your invoice count</li><li>Your customer TRNs, VAT codes and items checked and fixed</li><li>Registration and EmaraTax appointment done for you</li><li>A test invoice and credit note sent and checked</li><li>Rejected invoices fixed and your staff shown how it works</li></ul>
          <a class="btn-wa" id="helpWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> We'll do it for you</a>
        </div>
      </div>
      <ol class="steps5"><li><div><div class="st-head"><h3>Check your plan and data</h3><span class="tag you">You do it</span></div><p>Make sure you are on a paid Wafeq plan, Starter or higher. Check your TRN, and that every business customer has a TRN and every item has a VAT code.</p></div></li><li><div><div class="st-head"><h3>Switch on e-invoicing in Wafeq</h3><span class="tag you">You do it</span></div><p>Follow the "Switch on e-invoicing" prompt in Wafeq and enter your business details.</p></div></li><li><div><div class="st-head"><h3>Select Wafeq as your ASP on EmaraTax</h3><span class="tag you">You do it</span></div><p>Log in to EmaraTax, open E-Invoicing, select Wafeq as your ASP, verify and submit.</p></div></li><li><div><div class="st-head"><h3>Check the status is Active</h3><span class="tag you">You do it</span></div><p>Go back to Wafeq and check that e-invoicing shows as "Active".</p></div></li><li><div><div class="st-head"><h3>Fix gaps and send a test</h3><span class="tag you">You do it</span></div><p>Fill any missing customer TRNs and VAT codes, then send one test invoice and one credit note and check they go through.</p></div></li></ol>
    </section>
    <section>
      <h2>How does e-invoicing work with Wafeq?</h2>
      <ol class="flow"><li>You create the invoice in Wafeq, as you do today.</li><li>Wafeq, as your ASP, converts it to the UAE format (PINT AE) and checks it.</li><li>It is delivered through the Peppol network to your customer's ASP.</li><li>The invoice data is reported to the Federal Tax Authority (FTA).</li></ol>
    </section>
    <section>
      <h2>Things to know before you start</h2>
      <ul class="warn"><li><b>Check your plan's limits.</b> Plans differ in features and limits. Pick the one that fits your invoice count.</li><li><b>A PDF invoice is not a UAE e-invoice.</b> Emailing a PDF will not count for invoices in scope. They must go through an accredited ASP in the structured format.</li><li><b>You appoint one ASP.</b> The same ASP handles the e-invoices you send and the ones you receive.</li><li><b>Credit notes go through e-invoicing too.</b> To correct an invoice that has already been sent, issue a credit note.</li></ul>
      <p class="callout">Switching to Wafeq from QuickBooks or Excel? <a href="/switch-accounting-software">We move your data →</a></p>
    </section>
    
    <section class="sources"><h2>Sources</h2><ul><li><a href="https://mof.gov.ae/en/about-us/initiatives/einvoicing/" target="_blank" rel="noopener">UAE Ministry of Finance: e-invoicing</a></li><li><a href="https://www.wafeq.com/en-ae/press-releases/business-regulations-brief/wafeq-uae-e-invoicing-included-at-no-extra-cost" target="_blank" rel="noopener">Wafeq: UAE e-invoicing included at no extra cost</a></li></ul><p class="small">Prices and rules checked against these sources on {PRICES_CHECKED}. We update this page when they change.</p></section>
    <section>
      <h2>What is the e-invoicing deadline for Wafeq users?</h2>
      <p class="sub">Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b> and go live on <b>1 July 2027</b>. The fine for appointing late is <b>AED 5,000 a month</b>. After go-live, each invoice not issued electronically can be fined AED 100, up to AED 5,000 a month. Businesses over AED 50 million had to appoint by 30 October 2026 and go live on 1 January 2027.</p>
    </section>
    <section>
      <h2>Wafeq e-invoicing: common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.html ?? f.a} /></details>
        ))}
      </div>
    </section>
    <section class="final">
      <div><h2>Set it up yourself, or let us do it</h2><p class="sub">Stuck on a step, or rather not do it at all? Message us and we handle it for {aed(PRICES.help)}.</p></div>
      <a class="btn-wa" id="finalWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Ask us on WhatsApp</a>
    </section>
    <section>
      <h2>E-invoicing cost for other software</h2>
      <div class="more"><a href="/quickbooks-online">QuickBooks Online<span>Needs an ASP</span></a><a href="/quickbooks-desktop">QuickBooks Desktop<span>Needs an ASP</span></a><a href="/excel">Excel / no software<span>Needs an ASP</span></a><a href="/zoho-books">Zoho Books<span>Built-in ASP</span></a><a href="/tally">Tally Prime<span>Built-in ASP</span></a><a href="/other-software">Other software<span>Get a price</span></a><a href="/#compare">Compare all<span>Side by side</span></a></div>
    </section>
    <SiteFooter />
  </main>
  <div class="dock">
    <div class="row">
      <p class="fy cta" id="dockFy">Need e-invoice support?</p>
      <a class="btn-wa" id="dockWa" href="#" target="_blank" rel="noopener">WhatsApp Now</a>
    </div>
  </div>
  <script>
    import '../scripts/wafeq.js';
  </script>
</BaseLayout>
