---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guide.css';
import PriceBox from '../components/PriceBox.astro';
import PriceTable from '../components/PriceTable.astro';
import { PRICES, PRICES_CHECKED, fmt, aed, invoiceFee, firstYearText, everyYearText, connectorText } from '../config/prices.js';

const fy = firstYearText('qbo');
const ny = everyYearText();
const title = "QuickBooks Online E-Invoicing UAE: Cost & Setup 2027";
const description = `QuickBooks needs an accredited ASP for UAE e-invoicing. Cost: AED ${fy} first year, then AED ${ny} a year. See the 5 setup steps and the 2027 deadline.`;
const faqs = [
  {
    q: "Does QuickBooks Online support UAE e-invoicing?",
    a: "Not on its own. QuickBooks Online creates the invoice, but it cannot convert it to the UAE format or send it through the Peppol network. It must be connected to an accredited ASP, which does this for you."
  },
  {
    q: "Is QuickBooks an accredited service provider (ASP) in the UAE?",
    a: "No. QuickBooks is accounting software, not an accredited ASP. QuickBooks users must appoint an outside ASP on EmaraTax and connect it to QuickBooks."
  },
  {
    q: "How much does QuickBooks e-invoicing cost in the UAE?",
    a: `With us, AED ${fy} in the first year for up to 500 invoices: onboarding and ASP registration ${aed(PRICES.onboarding)}, setup ${aed(PRICES.setup)}, auto-send connector ${aed(PRICES.connector.qbo)}, platform fee ${aed(PRICES.platform)} and e-invoicing ${aed(PRICES.feeMin)}. After that it is AED ${ny} a year. Above 500, you pay for your exact number of invoices, with no slabs or brackets. Prices exclude VAT.`
  },
  {
    q: "What do I have to do?",
    a: "Nothing in the setup. You share access to QuickBooks and EmaraTax once, and we do every step. After go-live you keep invoicing in QuickBooks as usual."
  },
  {
    q: "Do I need to change my accounting software?",
    a: "No. You keep QuickBooks Online. The connector works in the background. If you would rather move to Zoho Books, Tally or Wafeq, we move your data too.",
    html: 'No. You keep QuickBooks Online. The connector works in the background. If you would rather move to Zoho Books, Tally or Wafeq, <a href="/switch-accounting-software">we move your data too</a>.'
  },
  {
    q: "How long does QuickBooks e-invoicing setup take?",
    a: "About 1 to 2 weeks, depending on how complete your customer TRNs and VAT codes are."
  },
  {
    q: "What is the e-invoicing deadline for QuickBooks users?",
    a: "The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month."
  },
  {
    q: "Do supplier invoices I receive count?",
    a: "No. Invoices you receive from suppliers are not counted in our fee. Count only the sales invoices and credit notes you send."
  }
];
const breadcrumbs = [
  {
    "name": "Home",
    "url": "https://einvoicecost.ae/"
  },
  {
    "name": "QuickBooks Online",
    "url": "https://einvoicecost.ae/quickbooks-online"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://einvoicecost.ae/quickbooks-online"
  ogType="article"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" id="topWa" href="https://wa.me/971508759256" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online" aria-current="page">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel">Excel</a><a href="/zoho-books">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq">Wafeq</a><a href="/other-software">Other software</a><a href="/switch-accounting-software">Switch software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › QuickBooks Online</p>
      <p class="eyebrow">QuickBooks Online · UAE e-invoicing guide</p>
      <h1>QuickBooks Online e-invoicing in the UAE: cost and setup</h1>
      <div class="answer">
        <p class="eyebrow">Quick answer</p>
        <p>QuickBooks Online has <b>no built-in UAE e-invoicing</b> and is not an Accredited Service Provider (ASP). It must be connected to an accredited ASP, which you appoint by 31 March 2027.</p><p>With us it costs <b>AED {fy} in the first year</b> (up to 500 invoices), then <b>AED {ny} a year</b>. We handle the whole setup. You keep invoicing in QuickBooks as usual.</p>
        <div class="facts"><div><p class="k">Needs an ASP</p><p class="v">Yes</p></div><div><p class="k">Your setup work</p><p class="v">None</p></div><div><p class="k">Ready in</p><p class="v">About 1–2 weeks</p></div></div>
      </div>
    </div>
  </div>
  <main class="wrap">
  
    <section id="cost">
      <h2>How much does QuickBooks Online e-invoicing cost in the UAE?</h2>
      <p class="sub">With us, <b>AED {fy} in the first year</b> for up to 500 invoices, then <b>AED {ny} a year</b>. One-time costs are onboarding and ASP registration {aed(PRICES.onboarding)}, setup {aed(PRICES.setup)} and the auto-send connector {aed(PRICES.connector.qbo)}. Every year you pay the platform fee of {aed(PRICES.platform)} plus {aed(PRICES.feeMin)} for up to 500 invoices. Above 500 invoices, you pay for your exact invoice count, with <b>no slabs or brackets</b>. Most providers only quote after a sales call. Here you see your exact price upfront. All prices in AED, excluding 5% VAT. Count the sales invoices and credit notes you send. Invoices you receive from suppliers are free.</p>
      <PriceBox sw="qbo" />
      <PriceTable sw="qbo" />
      <p class="small"><a href="/blog/uae-e-invoicing-cost#formula">See how the price is calculated →</a></p>
      <p class="small">More than 10,000 invoices a year? <a id="bigWa" href="#" target="_blank" rel="noopener">Message us on WhatsApp</a> for a price. The yearly fees are paid in advance.</p>
      <h3 class="sm">Your QuickBooks subscription is separate</h3>
      <p class="sub">It is paid to Intuit and not included above. Approximate UAE prices:</p>
      <div class="tablewrap"><table class="narrow"><thead><tr><th>QuickBooks plan</th><th>Users</th><th>About AED / month</th></tr></thead>
      <tbody><tr><td>Simple Start</td><td>1</td><td>77</td></tr><tr><td>Essentials</td><td>3</td><td>114</td></tr><tr><td>Plus</td><td>5</td><td>169</td></tr><tr><td>Advanced</td><td>25</td><td>327</td></tr></tbody></table></div>
      <p class="small">Intuit bills in US dollars and often runs discounts, so check your own plan price.</p>
    </section>
    <section id="covers">
      <h2>What do the fees cover?</h2>
      <p class="sub">Without a connector, someone has to upload or re-type every invoice by hand, every day. The connector is set up once and then runs on its own.</p>
      <ul class="covers">
        <li class="star"><b>Auto-send connector <span>· {aed(PRICES.connector.qbo)} one time</span></b>We set up and test a connector between QuickBooks and our accredited partner. Every invoice and credit note then goes from QuickBooks straight to your customer and the FTA in the government format. No uploading and no typing invoices twice.</li>
        <li><b>Onboarding &amp; ASP registration <span>· {aed(PRICES.onboarding)} one time</span></b>We open your account with our accredited partner and appoint it as your ASP on EmaraTax.</li>
        <li><b>Setup <span>· {aed(PRICES.setup)} one time</span></b>Your data checked and fixed, VAT codes matched to the UAE format (PINT AE), and test invoices sent before go-live.</li>
        <li><b>Platform fee <span>· {aed(PRICES.platform)} per year</span></b>Your e-invoicing account with our accredited partner, the connector kept running, and rejected invoices fixed.</li>
        <li><b>E-invoicing <span>· {aed(PRICES.feeMin)} per year</span></b>Up to 500 invoices and credit notes a year. Above 500, you pay for your exact count.</li>
      </ul>
    </section>
    <section id="steps">
      <h2>How to set up e-invoicing in QuickBooks Online</h2>
      <div class="handle">
        <div class="handle-big">
          <span class="mode">Done for you</span>
          <h3>We handle it<br>for you.</h3>
          <p>QuickBooks has no built-in UAE e-invoicing, so it needs an accredited provider. You don't do any setup work. Share access once and we handle every step.</p>
        </div>
        <div class="handle-side">
          <h4>All we need from you</h4>
          <ul><li>Access to QuickBooks: invite us as your accountant, or share a login.</li><li>Access to EmaraTax. We may ask you for a one-time code.</li><li>A copy of your trade licence and TRN certificate.</li></ul>
          <div class="eta">
            <div><p class="k">Ready in</p><p class="v">About 1–2 weeks</p></div>
            <div><p class="k">Your setup work</p><p class="v">None</p></div>
          </div>
        </div>
      </div>
      <ol class="steps5"><li><div><div class="st-head"><h3>Check your QuickBooks data</h3><span class="tag us">We handle it</span></div><p>We review your QuickBooks file before anything is connected: your company TRN and trade licence, the TRN of every business customer, a VAT code on every item and invoice line, and full customer addresses. Anything missing, we fix.</p><p class="note">Why it matters: missing customer TRNs and wrong VAT codes are a common reason e-invoices get rejected.</p></div></li><li><div><div class="st-head"><h3>Open your account and appoint the ASP</h3><span class="tag us">We handle it</span></div><p>We open your e-invoicing account with our accredited partner and appoint it as your ASP on EmaraTax for you. Your business then gets a Peppol ID, which is its address on the UAE e-invoicing network.</p></div></li><li><div><div class="st-head"><h3>Connect QuickBooks with the auto-send connector</h3><span class="tag us">We handle it</span></div><p>We set up the connector between QuickBooks Online and our accredited partner. From then on your invoices and credit notes go from QuickBooks straight to your customer and the FTA. Nothing is installed and QuickBooks stays exactly as it is.</p></div></li><li><div><div class="st-head"><h3>Match your VAT codes and items</h3><span class="tag us">We handle it</span></div><p>QuickBooks uses its own VAT codes and item names. The UAE e-invoice format (PINT AE) needs standard ones. We map each VAT code you use (standard 5%, zero-rated, exempt and others) and your items, units and customer types, so every invoice is read correctly.</p></div></li><li><div><div class="st-head"><h3>Test and go live</h3><span class="tag us">We handle it</span></div><p>We send test invoices and a credit note, check they are accepted and fix anything rejected. Then we switch it on. From that day you invoice in QuickBooks as usual and each invoice goes out automatically. If an invoice is rejected later, we fix it.</p></div></li></ol>
      
    </section>
    <section>
      <h2>How does e-invoicing work with QuickBooks Online?</h2>
      <ol class="flow"><li>You create the invoice in QuickBooks, as you do today.</li><li>The connector sends it to our accredited partner (ASP), which converts it to the UAE format (PINT AE) and checks it.</li><li>It is delivered through the Peppol network to your customer's ASP.</li><li>The invoice data is reported to the Federal Tax Authority (FTA).</li></ol>
    </section>
    <section>
      <h2>Things to know before you start</h2>
      <ul class="warn"><li><b>QuickBooks' own "e-invoicing" is not the UAE system.</b> When QuickBooks talks about e-invoicing, it usually means emailing invoices online. The UAE system needs an accredited ASP and the Peppol network.</li><li><b>A PDF invoice is not a UAE e-invoice.</b> Emailing a PDF will not count for invoices in scope. They must go through an accredited ASP in the structured format.</li><li><b>You appoint one ASP.</b> The same ASP handles the e-invoices you send and the ones you receive.</li><li><b>Credit notes go through e-invoicing too.</b> To correct an invoice that has already been sent, issue a credit note.</li><li><b>It covers invoices to businesses and government.</b> Sales to businesses (B2B) and to government (B2G) must be sent as e-invoices.</li></ul>
      <p class="callout">Thinking of switching to Zoho Books, Tally or Wafeq instead? <a href="/switch-accounting-software">We move your data →</a></p>
    </section>
    
    <section class="sources"><h2>Sources</h2><ul><li><a href="https://mof.gov.ae/en/about-us/initiatives/einvoicing/" target="_blank" rel="noopener">UAE Ministry of Finance: e-invoicing</a></li><li><a href="https://quickbooks.intuit.com/ae/resources/running-a-business/e-invoicing-compliance-in-the-uae" target="_blank" rel="noopener">QuickBooks UAE: e-invoicing compliance</a></li></ul><p class="small">Prices and rules checked against these sources on {PRICES_CHECKED}. We update this page when they change.</p></section>
    <section>
      <h2>What is the e-invoicing deadline for QuickBooks Online users?</h2>
      <p class="sub">Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b> and go live on <b>1 July 2027</b>. The fine for appointing late is <b>AED 5,000 a month</b>. After go-live, each invoice not issued electronically can be fined AED 100, up to AED 5,000 a month. Businesses over AED 50 million had to appoint by 30 October 2026 and go live on 1 January 2027.</p>
    </section>
    <section>
      <h2>QuickBooks Online e-invoicing: common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.html ?? f.a} /></details>
        ))}
      </div>
    </section>
    <section class="final">
      <div><h2>Get QuickBooks ready before 31 March</h2><p class="sub">Message us your invoice count. We reply with your price and next steps, usually the same day.</p></div>
      <a class="btn-wa" id="finalWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Let's discuss on WhatsApp</a>
    </section>
    <section>
      <h2>E-invoicing cost for other software</h2>
      <div class="more"><a href="/quickbooks-desktop">QuickBooks Desktop<span>Needs an ASP</span></a><a href="/excel">Excel / no software<span>Needs an ASP</span></a><a href="/zoho-books">Zoho Books<span>Built-in ASP</span></a><a href="/tally">Tally Prime<span>Built-in ASP</span></a><a href="/wafeq">Wafeq<span>Built-in ASP</span></a><a href="/other-software">Other software<span>Get a price</span></a><a href="/#compare">Compare all<span>Side by side</span></a></div>
    </section>
    <SiteFooter />
  </main>
  <div class="dock">
    <div class="row">
      <p class="fy cta" id="dockFy">Need e-invoice support?</p>
      <a class="btn-wa" id="dockWa" href="#" target="_blank" rel="noopener">WhatsApp Now</a>
    </div>
  </div>
  <script>
    import '../scripts/quickbooks-online.js';
  </script>
</BaseLayout>
