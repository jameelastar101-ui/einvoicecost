---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guide.css';

const title = "E-Invoicing Without Software UAE: Excel Cost 2027";
const description = "No accounting software? Do UAE e-invoicing with an Excel template and an accredited ASP. AED 3,500 first year, then AED 500 a year.";
const faqs = [
  {
    "q": "Can I do UAE e-invoicing without accounting software?",
    "a": "Yes. Your invoice data is filled in an Excel template and uploaded to an accredited ASP, which converts it to the UAE format and sends it through the Peppol network."
  },
  {
    "q": "Is a PDF invoice still valid after e-invoicing starts?",
    "a": "Not for invoices in scope. Once e-invoicing applies to your business, invoices to businesses and government must be sent as e-invoices through an ASP. A PDF or Word invoice does not count."
  },
  {
    "q": "How much does e-invoicing cost without software?",
    "a": "With us, AED 3,500 in the first year for up to 500 invoices: ASP registration AED 1,000, setup and template AED 2,000 and e-invoicing AED 500. After that it is AED 500 a year. Above 500, you pay for your exact number of invoices, with no slabs or brackets. Prices exclude VAT."
  },
  {
    "q": "Do I need to buy accounting software?",
    "a": "No. Excel and an accredited ASP are enough. If you send many invoices, software with a connector saves time."
  },
  {
    "q": "What do I have to do?",
    "a": "Nothing in the setup. After go-live, you fill the template and upload it each time you invoice, which takes a few minutes."
  },
  {
    "q": "How long does setup take?",
    "a": "About 1 week."
  },
  {
    "q": "What is the e-invoicing deadline for Excel users?",
    "a": "The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month."
  },
  {
    "q": "Do supplier invoices I receive count?",
    "a": "No. Invoices you receive from suppliers are not counted in our fee. Count only the sales invoices and credit notes you send."
  }
];
const breadcrumbs = [
  {
    "name": "Home",
    "url": "https://einvoicecost.ae/"
  },
  {
    "name": "Excel / no software",
    "url": "https://einvoicecost.ae/excel"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://einvoicecost.ae/excel"
  ogType="article"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" id="topWa" href="https://wa.me/971508759256" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel" aria-current="page">Excel</a><a href="/zoho-books">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq">Wafeq</a><a href="/other-software">Other software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › Excel / no software</p>
      <p class="eyebrow">Excel / no software · UAE e-invoicing guide</p>
      <h1>E-invoicing without accounting software: Excel cost and setup</h1>
      <div class="answer">
        <p class="eyebrow">Quick answer</p>
        <p>You can do UAE e-invoicing <b>without accounting software</b>. A PDF or Excel invoice is not an e-invoice by itself, but your invoice data can be uploaded to an accredited ASP, which sends it in the UAE format.</p><p>With us it costs <b>AED 3,500 in the first year</b> (up to 500 invoices), then <b>AED 500 a year</b>. We set everything up and hand you a ready Excel template.</p>
        <div class="facts"><div><p class="k">Needs an ASP</p><p class="v">Yes</p></div><div><p class="k">Your setup work</p><p class="v">None</p></div><div><p class="k">Ready in</p><p class="v">About 1 week</p></div></div>
      </div>
    </div>
  </div>
  <main class="wrap">
  
    <section id="cost">
      <h2>How much does Excel e-invoicing cost in the UAE?</h2>
      <p class="sub">With us, <b>AED 3,500 in the first year</b> for up to 500 invoices, then <b>AED 500 a year</b>. One-time costs are ASP registration AED 1,000 and setup AED 2,000. Above 500 invoices, you pay for your exact invoice count, with <b>no slabs or brackets</b>. Most providers only quote after a sales call. Here you see your exact price upfront. All prices in AED, excluding 5% VAT. Count the sales invoices and credit notes you send. Invoices you receive from suppliers are free.</p>
      <div class="tablewrap">
        <table class="stack inv three">
          <thead><tr><th>Invoices per year</th><th>ASP registration<br>(one time)</th><th>Setup &amp; connection<br>(one time)</th><th>E-invoicing<br>per year</th><th>First year<br>total</th><th>Each year<br>after</th></tr></thead>
          <tbody><tr><td>300</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">500</td><td class="tot" data-label="First year total">3,500</td><td class="tot" data-label="Each year after">500</td></tr><tr><td>500</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">500</td><td class="tot" data-label="First year total">3,500</td><td class="tot" data-label="Each year after">500</td></tr><tr><td>1,000</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">875</td><td class="tot" data-label="First year total">3,875</td><td class="tot" data-label="Each year after">875</td></tr><tr><td>2,000</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">1,625</td><td class="tot" data-label="First year total">4,625</td><td class="tot" data-label="Each year after">1,625</td></tr><tr><td>5,000</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">3,875</td><td class="tot" data-label="First year total">6,875</td><td class="tot" data-label="Each year after">3,875</td></tr><tr><td>10,000</td><td class="hm" data-label="ASP registration">1,000</td><td class="hm" data-label="Setup &amp; connection">2,000</td><td data-label="E-invoicing per year">7,625</td><td class="tot" data-label="First year total">10,625</td><td class="tot" data-label="Each year after">7,625</td></tr></tbody>
        </table>
      </div>
      <p class="small">More than 10,000 invoices a year? <a id="bigWa" href="#" target="_blank" rel="noopener">Message us on WhatsApp</a> for a price. The yearly fee is paid in advance.</p>
      <div class="calc" aria-live="polite">
        <div class="calc-in">
          <label for="inv">Your invoices per year</label>
          <div class="inv-box"><input id="inv" type="text" inputmode="numeric" value="500" aria-label="Invoices per year"><span>invoices</span></div>
        </div>
        <div class="calc-out">
          <div><p class="lab">First year</p><p class="val"><small>AED</small><span id="fy">3,500</span></p></div>
          <div><p class="lab">Every year after</p><p class="val"><small>AED</small><span id="ny">500</span></p></div>
        </div>
      </div>
      <p class="small">No software to buy. You only need Excel.</p>
    </section>
    <section id="covers">
      <h2>What does the AED 2,000 setup fee cover?</h2>
      <p class="sub">Without accounting software there is nothing to connect, so your invoices are uploaded instead. The setup fee pays for a template and portal built around your business, so each upload takes minutes.</p>
      <ul class="covers"><li class=star><b>A ready Excel template</b>Your customers, TRNs, items and VAT codes are already loaded, so you pick from lists and type amounts. Each upload is accepted the first time.</li><li><b>ASP registration done for you</b>We open your account with our accredited partner and appoint it as your ASP on EmaraTax.</li><li><b>Your upload portal set up</b>Your portal is ready, so each upload goes to your customer and the FTA in the government format.</li><li><b>VAT codes matched to the UAE format</b>Every VAT code and item mapped to PINT AE, the format the FTA reads.</li><li><b>Tested before go-live</b>Test invoices and a credit note are uploaded and checked before you start.</li><li><b>Rejected invoices fixed</b>If an invoice is rejected after go-live, we find the cause and fix it.</li></ul>
    </section>
    <section id="steps">
      <h2>How to set up e-invoicing in Excel</h2>
      <div class="handle">
        <div class="handle-big">
          <span class="mode">Done for you</span>
          <h3>We handle it<br>for you.</h3>
          <p>Without accounting software you need an accredited provider and a way to send invoice data. You don't do any setup work. We build everything and hand it over ready.</p>
        </div>
        <div class="handle-side">
          <h4>All we need from you</h4>
          <ul><li>A few recent invoices and your customer list.</li><li>Access to EmaraTax. We may ask you for a one-time code.</li><li>A copy of your trade licence and TRN certificate.</li></ul>
          <div class="eta">
            <div><p class="k">Ready in</p><p class="v">About 1 week</p></div>
            <div><p class="k">Your setup work</p><p class="v">None</p></div>
          </div>
        </div>
      </div>
      <ol class="steps5"><li><div><div class="st-head"><h3>Review your invoices and customers</h3><span class="tag us">We handle it</span></div><p>We look at your recent invoices and customer list: your TRN, the TRN of every business customer, the VAT on each line and full addresses. Anything missing, we fix.</p><p class="note">Why it matters: missing customer TRNs and wrong VAT are a common reason e-invoices get rejected.</p></div></li><li><div><div class="st-head"><h3>Open your account and appoint the ASP</h3><span class="tag us">We handle it</span></div><p>We open your e-invoicing account with our accredited partner and appoint it as your ASP on EmaraTax for you. Your business then gets a Peppol ID, which is its address on the UAE e-invoicing network.</p></div></li><li><div><div class="st-head"><h3>Build your Excel template</h3><span class="tag us">We handle it</span></div><p>We build a ready Excel template with your customers, TRNs, items and VAT codes already loaded, so you only pick from lists and type amounts.</p></div></li><li><div><div class="st-head"><h3>Set up your upload portal</h3><span class="tag us">We handle it</span></div><p>We set up your account on our accredited partner's portal, where the template is uploaded, and match your VAT codes to the UAE format (PINT AE).</p></div></li><li><div><div class="st-head"><h3>Test and go live</h3><span class="tag us">We handle it</span></div><p>We upload test invoices and a credit note, check they are accepted and fix anything rejected. Then we show you how to upload. Accepted and rejected invoices show in your portal, and we fix any rejection.</p></div></li></ol>
      <p class="sub" style="margin-top:18px"><b>After go-live:</b> each time you invoice, fill the template and upload it. It takes a few minutes. Prefer not to upload yourself? Ask us.</p>
    </section>
    <section>
      <h2>How does e-invoicing work with Excel?</h2>
      <ol class="flow"><li>You fill the invoice in your Excel template.</li><li>You upload it to our accredited partner's portal, which converts it to the UAE format (PINT AE) and checks it.</li><li>It is delivered through the Peppol network to your customer's ASP.</li><li>The invoice data is reported to the Federal Tax Authority (FTA).</li></ol>
    </section>
    <section>
      <h2>Things to know before you start</h2>
      <ul class="warn"><li><b>Excel suits a few hundred invoices a year.</b> If you send many invoices, accounting software with a connector saves time every day.</li><li><b>A PDF invoice is not a UAE e-invoice.</b> Emailing a PDF will not count for invoices in scope. They must go through an accredited ASP in the structured format.</li><li><b>You appoint one ASP.</b> The same ASP handles the e-invoices you send and the ones you receive.</li><li><b>Credit notes go through e-invoicing too.</b> To correct an invoice that has already been sent, issue a credit note.</li><li><b>It covers invoices to businesses and government.</b> Sales to businesses (B2B) and to government (B2G) must be sent as e-invoices.</li></ul>
    </section>
    
    <section class="sources"><h2>Sources</h2><ul><li><a href="https://mof.gov.ae/en/about-us/initiatives/einvoicing/" target="_blank" rel="noopener">UAE Ministry of Finance: e-invoicing</a></li></ul><p class="small">Prices and rules checked against these sources on 9 November 2026. We update this page when they change.</p></section>
    <section>
      <h2>What is the e-invoicing deadline for Excel users?</h2>
      <p class="sub">Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b> and go live on <b>1 July 2027</b>. The fine for appointing late is <b>AED 5,000 a month</b>. After go-live, each invoice not issued electronically can be fined AED 100, up to AED 5,000 a month. Businesses over AED 50 million had to appoint by 30 October 2026 and go live on 1 January 2027.</p>
    </section>
    <section>
      <h2>Excel e-invoicing: common questions</h2>
      <div class="faq"><details><summary>Can I do UAE e-invoicing without accounting software?</summary><p>Yes. Your invoice data is filled in an Excel template and uploaded to an accredited ASP, which converts it to the UAE format and sends it through the Peppol network.</p></details><details><summary>Is a PDF invoice still valid after e-invoicing starts?</summary><p>Not for invoices in scope. Once e-invoicing applies to your business, invoices to businesses and government must be sent as e-invoices through an ASP. A PDF or Word invoice does not count.</p></details><details><summary>How much does e-invoicing cost without software?</summary><p>With us, AED 3,500 in the first year for up to 500 invoices: ASP registration AED 1,000, setup and template AED 2,000 and e-invoicing AED 500. After that it is AED 500 a year. Above 500, you pay for your exact number of invoices, with no slabs or brackets. Prices exclude VAT.</p></details><details><summary>Do I need to buy accounting software?</summary><p>No. Excel and an accredited ASP are enough. If you send many invoices, software with a connector saves time.</p></details><details><summary>What do I have to do?</summary><p>Nothing in the setup. After go-live, you fill the template and upload it each time you invoice, which takes a few minutes.</p></details><details><summary>How long does setup take?</summary><p>About 1 week.</p></details><details><summary>What is the e-invoicing deadline for Excel users?</summary><p>The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month.</p></details><details><summary>Do supplier invoices I receive count?</summary><p>No. Invoices you receive from suppliers are not counted in our fee. Count only the sales invoices and credit notes you send.</p></details></div>
    </section>
    <section class="final">
      <div><h2>Ready without buying software</h2><p class="sub">Message us your invoice count. We reply with your price and next steps, usually the same day.</p></div>
      <a class="btn-wa" id="finalWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Let's discuss on WhatsApp</a>
    </section>
    <section>
      <h2>E-invoicing cost for other software</h2>
      <div class="more"><a href="/quickbooks-online">QuickBooks Online<span>Needs an ASP</span></a><a href="/quickbooks-desktop">QuickBooks Desktop<span>Needs an ASP</span></a><a href="/zoho-books">Zoho Books<span>Built-in ASP</span></a><a href="/tally">Tally Prime<span>Built-in ASP</span></a><a href="/wafeq">Wafeq<span>Built-in ASP</span></a><a href="/other-software">Other software<span>Get a price</span></a><a href="/#compare">Compare all<span>Side by side</span></a></div>
    </section>
    <footer>
      <span>Prices checked: 9 November 2026</span>
      <span>einvoicecost.ae · Exact UAE e-invoicing prices, shown upfront · Dubai</span>
    </footer>
  </main>
  <div class="dock">
    <div class="row">
      <p class="fy cta" id="dockFy">Need e-invoice support?</p>
      <a class="btn-wa" id="dockWa" href="#" target="_blank" rel="noopener">WhatsApp Now</a>
    </div>
  </div>
  <script>
    import '../scripts/excel.js';
  </script>
</BaseLayout>
