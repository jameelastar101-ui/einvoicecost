const faqs: FAQ[] = [
  { q: "Is Tally an accredited service provider (ASP) in the UAE?", a: "Yes. Tally Software Solutions FZCO is an accredited ASP. TallyPrime users appoint Tally on EmaraTax. They do not need another provider." },
  { q: "Is Tally e-invoicing free in the UAE?", a: "There is no per-invoice fee. E-invoicing is included in TallyPrime as long as your TSS subscription is active. You still pay for TSS or a licence." },
