};

const toc = [
  ['what', 'What it is'], ['travel', 'How an invoice travels'], ['deadlines', 'Who goes live when'], ['cost', 'What it costs'], ['plans', 'Which plan fits'],
  ['setup', 'Set up in 5 steps'], ['data', 'Data to fix first'], ['services', 'Service companies'], ['traders', 'Small traders'],
  ['distributors', 'Distributors'], ['contractors', 'Contractors'], ['subs', 'Subcontractors'], ['compare', 'Five business types'],
  ['mistakes', 'Mistakes that cause rejections'], ['know', 'Before you start'], ['switch', 'Thinking of switching'], ['help', 'Yourself or with help'],
  ['faq', 'Questions'], ['sources', 'Sources'],
];
---

