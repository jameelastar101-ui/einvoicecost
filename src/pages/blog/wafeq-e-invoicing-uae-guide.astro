const setupWa = ctaWa;

type FAQ = { q: string; a: string };

const faqs: FAQ[] = [
  { q: "Is Wafeq an accredited service provider (ASP) in the UAE?", a: "Yes. Wafeq FZ-LLC is an accredited ASP with ASP ID 129932. Wafeq users appoint Wafeq on EmaraTax. They do not need another provider." },
  { q: "Is Wafeq e-invoicing free in the UAE?", a: "There is no extra charge for e-invoicing and no per-invoice fee. It is included in the Starter, Plus and Premium plans. You still pay for the plan: AED 690, AED 960 or AED 2,400 a year." },
  { q: "How much does Wafeq e-invoicing cost for a small business?", a: "A small service firm can start on Starter at AED 690 a year. That is about AED 57 a month. The e-invoicing fee is AED 0, whether you send 50 invoices or 5,000." },
  { q: "Which Wafeq plan do I need for e-invoicing?", a: "Any paid plan works. E-invoicing is in all three. Pick by the accounting features and limits you need, not by e-invoicing." },
  { q: "How do I set up e-invoicing in Wafeq?", a: "Switch on e-invoicing in Wafeq. Appoint Wafeq FZ-LLC on EmaraTax. Choose your start date and check that the status is active. Then fix any gaps and send a test invoice and credit note." },
  { q: "How long does Wafeq e-invoicing setup take?", a: "Most businesses finish in about a day. The forms are quick. The slow part is cleaning customer and item data." },
