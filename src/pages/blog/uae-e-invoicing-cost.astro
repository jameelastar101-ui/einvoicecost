---
import SiteFooter from '../../components/SiteFooter.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/guide.css';
import '../../styles/blog.css';
import { PRICES as P, WA, fmt, aed, invoiceFee, zohoFee, price, firstYearText, everyYearText, connectorText } from '../../config/prices.js';

/** Update these two whenever prices or rules change. */
const PUBLISHED = '2026-11-13';
const UPDATED_ISO = '2026-11-13';
const UPDATED = '13 November 2026';

const URL = 'https://einvoicecost.ae/blog/uae-e-invoicing-cost';
const N0 = P.feeCovered; // 500
const first = (k: string, n = N0) => price(k, n).firstYear;
const every = (k: string, n = N0) => price(k, n).everyYear;
const avg = (n: number) => (invoiceFee(n) / n).toFixed(2);
const vat = (n: number) => fmt(n * 1.05);

const qboFy = fmt(first('qbo'));
const qbdFy = fmt(first('qbd'));
const xlFy = fmt(first('excel'));
const ny = everyYearText();
const perExtra = P.feePerExtra.toFixed(2);
const connQbo = connectorText('qbo');
const connQbd = connectorText('qbd');
const oneTime = P.onboarding + P.setup; // before connector
const zoho = (n: number) => fmt(zohoFee(n));

const title = 'UAE E-INVOICING COST 2027: COMPLETE PRICE GUIDE, FORMULA & EXAMPLES';
const description =
  'How much does e-invoicing cost in the UAE? Exact prices for QuickBooks, Excel, Zoho Books, TallyPrime, Wafeq and other software, the price formula, worked examples, hidden costs, deadlines and penalties.';

const wa = (t: string) => `https://wa.me/${WA}?text=${encodeURIComponent(t)}`;
const ctaWa = wa('Hi, I read your e-invoicing cost guide. I use [software], about [number] invoices a year. Please send me my price.');

// Invoice counts used in the volume and full price tables
const COUNTS = [300, 500, 800, 1000, 1500, 2000, 3000, 5000, 7500, 10000];

type FAQ = { q: string; a: string };

const costFaqs: FAQ[] = [
  { q: 'How much does e-invoicing cost in the UAE?', a: `It depends on your accounting software and how many invoices you send. With einvoicecost.ae, the first year for up to ${N0} invoices costs ${aed(first('qbo'))} for QuickBooks Online, ${aed(first('qbd'))} for QuickBooks Desktop, ${aed(first('excel'))} for Excel, and ${aed(first('other'))} plus a connector for other software. Every year after costs ${aed(every('excel'))}. Zoho Books, TallyPrime and Wafeq have e-invoicing built in, so there is no ASP or platform fee; setup is free if you do it yourself or ${aed(P.help)} if we do it. Prices exclude 5% VAT.` },
  { q: 'Is e-invoicing free in the UAE?', a: 'The government does not charge you for e-invoicing, but you must use an accredited service provider (ASP). It can be close to free if your accounting software is an ASP itself: TallyPrime includes it with an active TSS subscription and Wafeq includes it in paid plans. Zoho Books charges for e-invoicing packs. QuickBooks, Excel and most other software need an outside ASP, which charges a fee.' },
  { q: 'What is the cheapest way to comply with UAE e-invoicing?', a: `If you already use TallyPrime or Wafeq, setting it up yourself is the cheapest, because e-invoicing is included. If you use QuickBooks or Excel, the cheapest route with einvoicecost.ae is the Excel upload option at ${aed(first('excel'))} in the first year and ${aed(every('excel'))} a year after, for up to ${N0} invoices. Switching software can lower the yearly cost but adds migration and retraining costs.` },
  { q: 'How is the e-invoicing price calculated on einvoicecost.ae?', a: `First year = onboarding and ASP registration ${aed(P.onboarding)} + setup ${aed(P.setup)} + auto-send connector + platform fee ${aed(P.platform)} + invoice fee. The invoice fee is ${aed(P.feeMin)} for up to ${N0} invoices a year, plus AED ${perExtra} for each invoice above ${N0}. Every year after = platform fee ${aed(P.platform)} + invoice fee. The connector is ${aed(P.connector.qbo)} for QuickBooks Online, ${aed(P.connector.qbd)} for QuickBooks Desktop, not needed for Excel, and quoted for other software.` },
  { q: 'Does the price per invoice go down as volume grows?', a: `Yes. The first ${N0} invoices cost ${aed(P.feeMin)} in total, and each invoice above ${N0} costs AED ${perExtra}. Because the fixed ${aed(P.feeMin)} is spread over more invoices, the average price per invoice falls from AED ${avg(500)} at 500 invoices to about AED ${avg(1000)} at 1,000, AED ${avg(2000)} at 2,000 and AED ${avg(10000)} at 10,000. It never goes below AED ${perExtra}. There are no slabs, so you pay for your exact invoice count.` },
  { q: 'How much does QuickBooks Online e-invoicing cost in the UAE?', a: `With einvoicecost.ae, ${aed(first('qbo'))} in the first year for up to ${N0} invoices: onboarding ${aed(P.onboarding)}, setup ${aed(P.setup)}, auto-send connector ${aed(P.connector.qbo)}, platform fee ${aed(P.platform)} and invoices ${aed(P.feeMin)}. Then ${aed(every('qbo'))} a year. Your QuickBooks subscription is separate.` },
  { q: 'How much does QuickBooks Desktop e-invoicing cost in the UAE?', a: `With einvoicecost.ae, ${aed(first('qbd'))} in the first year for up to ${N0} invoices, because the auto-send connector installed on your QuickBooks computer costs ${aed(P.connector.qbd)}. Then ${aed(every('qbd'))} a year.` },
  { q: 'How much does e-invoicing cost without accounting software?', a: `With einvoicecost.ae, ${aed(first('excel'))} in the first year for up to ${N0} invoices using a ready Excel template and upload portal, then ${aed(every('excel'))} a year. No connector is needed.` },
  { q: 'How much does Zoho Books e-invoicing cost?', a: `Zoho Books is an ASP itself. You need the Professional plan or higher (about AED 90 a month on yearly billing) and you buy one-time e-invoicing packs: about AED ${zoho(500)} for 500, AED ${zoho(1000)} for 1,000, AED ${zoho(5000)} for 5,000 and AED ${zoho(10000)} for 10,000. The first 100 are free once. Setup is free if you do it yourself, or ${aed(P.help)} with us.` },
  { q: 'Is Tally e-invoicing free in the UAE?', a: `There is no per-invoice fee in TallyPrime while your TSS subscription is active. TSS Silver renewal is about AED 468 a year. Setup is free if you do it yourself, or ${aed(P.help)} with us.` },
  { q: 'Do invoices I receive from suppliers count in the price?', a: 'Not with einvoicecost.ae. Our invoice fee counts only the sales invoices and credit notes you send. Some providers count received documents too, which can double the count, so ask before you sign.' },
  { q: 'Do I need e-invoicing if I only sell to consumers (B2C)?', a: 'B2C transactions are excluded from UAE e-invoicing for now. If you also sell to businesses or government, those invoices are in scope.' },
  { q: 'Is a PDF invoice still valid after e-invoicing starts?', a: 'Not for invoices in scope. They must be sent as structured e-invoices (PINT AE format) through an accredited service provider. A PDF or scanned invoice does not count.' },
  { q: 'What is the deadline for UAE e-invoicing?', a: 'Businesses with revenue under AED 50 million must appoint an ASP by 31 March 2027 and go live on 1 July 2027. Businesses with AED 50 million or more had to appoint by 30 October 2026 and go live on 1 January 2027. Government entities go live on 1 October 2027.' },
  { q: 'What is the penalty for not appointing an ASP on time?', a: 'AED 5,000 for each month under Cabinet Decision No. 106 of 2025. Not issuing an e-invoice or e-credit note can cost AED 100 each, up to AED 5,000 a month for each type.' },
  { q: 'What is an ASP?', a: "An Accredited Service Provider approved by the UAE Ministry of Finance. It checks each invoice, converts it to the UAE format (PINT AE), sends it through the Peppol network to your customer's ASP and reports the data to the Federal Tax Authority. You appoint your ASP on EmaraTax." },
  { q: 'Do both the seller and the buyer need an ASP?', a: 'Yes. Each business in scope appoints one ASP, which handles the e-invoices it sends and receives.' },
  { q: 'Can I keep using QuickBooks or Excel?', a: 'Yes. QuickBooks and Excel are not ASPs, so they need an outside ASP plus a connector (QuickBooks) or an upload template (Excel). You do not have to change your accounting software.' },
  { q: 'Is it cheaper to switch to Zoho, Tally or Wafeq?', a: 'The yearly e-invoicing cost is lower on built-in software, but switching adds a one-time data migration and staff retraining. For many small businesses with years of history in QuickBooks, staying is simpler. We quote migration on WhatsApp after checking your data.' },
  { q: 'How long does e-invoicing setup take?', a: 'Usually about 1 week for Excel, 1 to 2 weeks for QuickBooks Online, 2 to 3 weeks for QuickBooks Desktop, and a few hours to a day for Zoho Books, TallyPrime or Wafeq if your data is clean.' },
  { q: 'Are e-invoicing prices including VAT?', a: 'No. All einvoicecost.ae prices exclude 5% VAT. Multiply by 1.05 for the price including VAT.' },
  { q: 'How much does e-invoicing cost for a group of companies?', a: 'Each company (each TRN) is set up and appointed separately, so each has its own setup and yearly fees. Transactions between members of the same tax group are excluded from e-invoicing for two years from 1 January 2027. Message us on WhatsApp for a group quote.' },
];

const moreGroups: { title: string; items: FAQ[] }[] = [
  { title: 'Basics', items: [
    { q: 'What is e-invoicing in the UAE?', a: "E-invoicing means sending invoices as structured data (an XML file in the PINT AE format) through an accredited service provider, instead of as PDF or paper. The provider checks each invoice, delivers it to your customer's provider over the Peppol network and reports the data to the Federal Tax Authority." },
    { q: 'What is DCTCE and the five-corner model?', a: "DCTCE (Decentralised Continuous Transaction Control and Exchange) is the name of the UAE e-invoicing model. It works in five corners: the seller (1) sends the invoice to its ASP (2), which delivers it to the buyer's ASP (3), which passes it to the buyer (4), and the invoice data is reported to the FTA (5)." },
    { q: 'What is PINT AE?', a: 'PINT AE is the UAE version of the Peppol International Invoice standard. It defines the format and the required fields of every UAE e-invoice. Your ASP converts your invoice into PINT AE.' },
    { q: 'What is a Peppol ID?', a: "Your business's address on the Peppol network. It is created when you register with your ASP, and other businesses' providers use it to deliver e-invoices to you." },
    { q: 'What are the benefits of e-invoicing for a small business?', a: 'Fewer invoice errors, faster delivery to customers, invoices checked before they are sent, less manual VAT work and a cleaner record if the FTA asks questions.' },
  ] },
  { title: 'Deadlines and scope', items: [
    { q: 'Is there a minimum business size for e-invoicing in the UAE?', a: 'No. There is no small-business exemption. Businesses with revenue under AED 50 million are in the second phase: appoint an ASP by 31 March 2027 and go live on 1 July 2027. Only some transactions, such as sales to consumers (B2C), are excluded for now.' },
    { q: 'What is the e-invoicing pilot or voluntary phase?', a: 'Businesses that are ready can start e-invoicing voluntarily from 1 July 2026, before their mandatory phase. Penalties apply only once your mandatory phase starts.' },
  ] },
  { title: 'Choosing and appointing an ASP', items: [
    { q: 'How do I appoint an ASP on EmaraTax?', a: 'Log in to EmaraTax, open your business profile, go to the E-Invoicing section, select your ASP from the list, verify with your email and TIN, and submit. With TallyPrime and Zoho Books you start this step from inside the software. We guide you through it on a short call.' },
    { q: 'How do I know if an e-invoicing provider is accredited?', a: "Check the Ministry of Finance list of eInvoicing Accredited Service Providers, which shows each provider's legal company name. It listed 86 providers on 11 November 2026. A provider that is not on the list may be reselling an accredited one." },
    { q: 'How do I choose an e-invoicing service provider?', a: 'Compare the total cost for the first year and every year after, whether received invoices are counted, whether connecting your software is included, who fixes rejected invoices, how fast they reply, and whether the contract renews automatically.' },
    { q: 'Is QuickBooks an accredited service provider in the UAE?', a: 'No. QuickBooks Online and QuickBooks Desktop are accounting software, not ASPs. QuickBooks users appoint an outside ASP and connect it to QuickBooks with a connector.' },
    { q: 'Is Zoho Books an accredited service provider in the UAE?', a: 'Yes. Zoho is on the Ministry of Finance list as Zoho Software Trading LLC, so Zoho Books users appoint Zoho on EmaraTax and need no other provider. TallyPrime (Tally Software Solutions FZCO) and Wafeq are also on the list.' },
    { q: 'Can my accountant set up e-invoicing for me?', a: 'Yes. An accountant or e-invoicing consultant can check your data, connect your software, test and go live for you. You still approve the ASP appointment on EmaraTax, usually with a one-time code.' },
  ] },
  { title: 'Issuing, correcting and receiving invoices', items: [
    { q: 'How quickly must an e-invoice be issued?', a: 'Generally within 14 days of the supply, in line with UAE VAT invoice rules. Once your phase starts, an invoice in scope that is not issued and sent electronically can be fined AED 100.' },
    { q: 'What information must a UAE e-invoice include?', a: "The fields required by PINT AE, including your TRN, your customer's TRN or tax ID, invoice number and date, item descriptions, quantities, VAT rate and VAT amount for each line, and totals. Missing customer TRNs and VAT codes are common reasons for rejection." },
    { q: 'Can I edit or cancel an e-invoice after sending it?', a: 'No. Once sent, an e-invoice cannot be edited or deleted. You correct it by issuing an electronic credit note, which also goes through your ASP.' },
    { q: 'What happens if my e-invoice is rejected?', a: 'Your ASP checks every invoice before sending it. If an invoice fails the checks, it is rejected and you must fix the data and send it again. With einvoicecost.ae, we find the cause and fix rejected invoices for you.' },
    { q: 'Do I need an ASP to receive invoices from suppliers?', a: "Yes. Your ASP receives e-invoices from your suppliers' providers as well as sending yours. With einvoicecost.ae, received invoices are not counted in our fee." },
  ] },
  { title: 'Records and VAT', items: [
    { q: 'Does e-invoicing replace VAT returns?', a: 'No. You still file your VAT returns as usual. E-invoicing changes how invoices are issued and reported, not your VAT return obligation.' },
    { q: 'How long must I keep e-invoices?', a: 'For the period set by the Tax Procedures Law, generally 5 years from the end of the tax period. You must give the records to the FTA on request. The October 2026 amendments removed the rule that the data must be stored inside the UAE.' },
  ] },
];

const faqs: FAQ[] = [...costFaqs, ...moreGroups.flatMap((g) => g.items)];
const moreCount = faqs.length - costFaqs.length;

const breadcrumbs = [
  { name: 'Home', url: 'https://einvoicecost.ae/' },
  { name: 'UAE e-invoicing cost', url: URL },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'UAE e-invoicing cost 2027: complete price guide, formula and examples',
  description:
    'How much UAE e-invoicing costs for QuickBooks, Excel, Zoho Books, TallyPrime, Wafeq and other software, with the price formula, worked examples, price tables, hidden costs, deadlines and penalties.',
  datePublished: PUBLISHED,
  dateModified: UPDATED_ISO,
  author: { '@type': 'Organization', name: 'einvoicecost.ae', url: 'https://einvoicecost.ae' },
  publisher: { '@type': 'Organization', name: 'einvoicecost.ae', url: 'https://einvoicecost.ae' },
  mainEntityOfPage: URL,
  inLanguage: 'en',
};

// Worked examples (all numbers computed)
const e1 = price('qbo', 800), e2 = price('qbd', 1500), e3 = price('excel', 300), e4 = price('qbo', 3000), e5 = price('other', 2000);
const base5 = P.onboarding + P.setup + P.platform; // first year before connector and invoice fee

const toc = [
  ['answer', 'Quick answer'], ['what', 'What you actually pay for'], ['prices', 'Our prices by software'], ['formula', 'The price formula'],
  ['volume', 'Price for every invoice count'], ['examples', 'Worked examples'], ['tables', 'Full price tables'], ['software', 'Cost by accounting software'],
  ['count', 'How to count your invoices'], ['hidden', 'Hidden costs to budget for'], ['budget', 'Budget examples by business'],
  ['models', 'How e-invoicing pricing works in the market'], ['switch', 'Keep your software or switch?'], ['deadlines', 'Deadlines'],
  ['penalties', 'Penalties: the cost of doing nothing'], ['scope', 'Who must use e-invoicing'], ['basics', 'E-invoicing basics in plain words'],
  ['start', 'How to get started in 5 steps'], ['faq', 'Cost questions'], ['more', `${moreCount} more questions about UAE e-invoicing`], ['sources', 'Sources'],
];

const budget = [
  ['Small trading company', 'Excel', 300, 'excel'],
  ['Service company', 'QuickBooks Online', 800, 'qbo'],
  ['Contractor', 'QuickBooks Desktop', 1500, 'qbd'],
  ['Distributor', 'QuickBooks Online', 3000, 'qbo'],
] as const;
const guides = [
  ['QuickBooks Online', '/quickbooks-online'], ['QuickBooks Desktop', '/quickbooks-desktop'], ['Excel', '/excel'],
  ['Zoho Books', '/zoho-books'], ['Tally', '/tally'], ['Wafeq', '/wafeq'], ['Other software', '/other-software'],
];
const penalty6 = 6 * 5000;
---

<BaseLayout title={title} description={description} canonicalURL={URL} ogType="article" faqs={faqs} breadcrumbs={breadcrumbs}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>

  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" href={`https://wa.me/${WA}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel">Excel</a><a href="/zoho-books">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq">Wafeq</a><a href="/other-software">Other software</a><a href="/switch-accounting-software">Switch software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › Blog › UAE e-invoicing cost</p>
      <p class="eyebrow">Blog · Complete price guide</p>
      <h1>UAE E-INVOICING COST 2027: THE COMPLETE PRICE GUIDE</h1>
      <p class="byline"><span>Updated <b>{UPDATED}</b></span><span>Prices in AED, excluding 5% VAT</span></p>
      <div class="answer" id="answer">
        <p class="eyebrow">Quick answer</p>
        <p>UAE e-invoicing costs between <b>AED 0 and about AED {fmt(Math.round(first('qbd') / 1000) * 1000)} in the first year</b> for a small business, depending on your accounting software and invoice count. With einvoicecost.ae, up to {N0} invoices costs <b>AED {qboFy} for QuickBooks Online</b>, <b>AED {qbdFy} for QuickBooks Desktop</b>, <b>AED {xlFy} for Excel</b> and <b>AED {fmt(first('other'))} plus a connector</b> for other software in the first year, then <b>AED {ny} a year</b>. Above {N0} invoices, add <b>AED {perExtra} per invoice</b>.</p>
        <p><b>Zoho Books, TallyPrime and Wafeq</b> have e-invoicing built in: no ASP fee, no connector and no platform fee. Setup is free if you do it yourself, or {aed(P.help)} if we do it. Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b>.</p>
        <div class="facts">
          <div><p class="k">Up to {N0} invoices</p><p class="v">{aed(P.feeMin)} a year</p></div>
          <div><p class="k">Each invoice above {N0}</p><p class="v">AED {perExtra}</p></div>
          <div><p class="k">Every year after</p><p class="v">{aed(P.platform)} + invoice fee</p></div>
        </div>
      </div>
    </div>
  </div>

  <main class="wrap blog">
    <nav class="toc" aria-label="Contents"><b>In this guide</b><ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>

    <section id="what">
      <h2>What you actually pay for</h2>
      <p>The UAE government does not charge businesses for e-invoicing. What you pay for is the service that sends your invoices in the government format. Every business in scope must appoint an <b>Accredited Service Provider (ASP)</b>, approved by the Ministry of Finance, to do this.</p>
      <p>Your total e-invoicing cost has three parts:</p>
      <ul class="know">
        <li><b>The ASP and its setup.</b> Either your accounting software is an ASP itself (Zoho Books, TallyPrime, Wafeq), or you pay an outside ASP and someone to connect it to your software.</li>
        <li><b>Your accounting software.</b> Some software needs a higher plan or an active subscription for e-invoicing to work.</li>
        <li><b>Your own time.</b> Fixing customer TRNs, VAT codes and item data, training staff, and fixing rejected invoices. This is the cost most owners forget.</li>
      </ul>
      <p>einvoicecost.ae shows the first two in AED, upfront, and takes most of the third off your hands: we do the setup, data checks, testing and rejected-invoice fixes.</p>
    </section>

    <section id="prices">
      <h2>Our prices by software</h2>
      <p>For software without built-in e-invoicing, the price has five parts. Three are paid once. Two are paid every year, in advance.</p>
      <div class="tablewrap"><table class="w700"><thead><tr><th>Part</th><th>How often</th><th>QuickBooks Online</th><th>QuickBooks Desktop</th><th>Excel</th><th>Other software</th></tr></thead><tbody>
        <tr><td>Onboarding &amp; ASP registration</td><td>One time</td><td>{fmt(P.onboarding)}</td><td>{fmt(P.onboarding)}</td><td>{fmt(P.onboarding)}</td><td>{fmt(P.onboarding)}</td></tr>
        <tr><td>Setup</td><td>One time</td><td>{fmt(P.setup)}</td><td>{fmt(P.setup)}</td><td>{fmt(P.setup)}</td><td>{fmt(P.setup)}</td></tr>
        <tr><td>Auto-send connector</td><td>One time</td><td>{connQbo}</td><td>{connQbd}</td><td>Not needed</td><td>Quoted</td></tr>
        <tr><td>Platform fee</td><td>Every year</td><td>{fmt(P.platform)}</td><td>{fmt(P.platform)}</td><td>{fmt(P.platform)}</td><td>{fmt(P.platform)}</td></tr>
        <tr><td>Invoice fee (up to {N0})</td><td>Every year</td><td>{fmt(P.feeMin)}</td><td>{fmt(P.feeMin)}</td><td>{fmt(P.feeMin)}</td><td>{fmt(P.feeMin)}</td></tr>
        <tr><td><b>First year</b></td><td></td><td><b>{qboFy}</b></td><td><b>{qbdFy}</b></td><td><b>{xlFy}</b></td><td><b>{fmt(first('other'))} + connector</b></td></tr>
        <tr><td><b>Every year after</b></td><td></td><td><b>{ny}</b></td><td><b>{ny}</b></td><td><b>{ny}</b></td><td><b>{ny}</b></td></tr>
      </tbody></table></div>
      <p class="small">The <b>auto-send connector</b> sends each invoice from your software to the FTA and your customer automatically. Excel users upload a ready template instead, so they need no connector. For other software (Odoo, Sage, Xero, Microsoft Dynamics, ERPNext and others) every price is the same; only the connector is quoted, because each software connects differently.</p>
    </section>

    <section id="formula">
      <h2>The price formula</h2>
      <p>Use this to work out the price for any invoice count. <b>n</b> is the number of sales invoices and credit notes you send in a year.</p>
      <div class="formula"><p class="fh">einvoicecost.ae price formula (AED, excl. VAT)</p><pre>{`Invoice fee        = ${P.feeMin}                      if n is ${N0} or less
                   = ${P.feeMin} + ${perExtra} × (n − ${N0})   if n is more than ${N0}

One-time fees      = Onboarding ${fmt(P.onboarding)} + Setup ${fmt(P.setup)} + Connector
Connector          = QuickBooks Online ${connQbo}
                     QuickBooks Desktop ${connQbd}
                     Excel 0 (you upload)
                     Other software: quoted on WhatsApp

First year         = One-time fees + Platform fee ${fmt(P.platform)} + Invoice fee
Every year after   = Platform fee ${fmt(P.platform)} + Invoice fee
With VAT           = Price × 1.05`}</pre></div>
      <p class="small">There are no slabs or brackets. Above {N0} invoices you pay for your exact count. More than 10,000 invoices a year: ask us on WhatsApp.</p>
    </section>

    <section id="volume">
      <h2>Price for every invoice count: the rate drops as you grow</h2>
      <p>Most providers sell e-invoicing in slabs or packs, so 501 invoices costs the same as 1,000. We charge for your <b>exact</b> invoice count instead. The first {N0} invoices cost {aed(P.feeMin)} in total, and each invoice after that costs AED {perExtra}.</p>
      <p>Because the fixed {aed(P.feeMin)} is spread over more invoices, <b>your average price per invoice keeps falling as volume grows</b>, from AED {avg(500)} at {N0} invoices toward AED {perExtra}. It never goes below AED {perExtra}, and adding one invoice never adds more than AED {perExtra}.</p>
      <div class="tablewrap"><table><thead><tr><th>Invoices a year</th><th>Invoice fee</th><th>Average per invoice</th><th>Every year after (fee + platform)</th></tr></thead><tbody>
        {COUNTS.map((n) => <tr><td>{fmt(n)}</td><td>{fmt(invoiceFee(n))}</td><td>{avg(n)}{n < N0 ? ' (minimum fee)' : ''}</td><td>{fmt(P.platform + invoiceFee(n))}</td></tr>)}
      </tbody></table></div>
    </section>

    <section id="examples">
      <h2>Worked examples</h2>
