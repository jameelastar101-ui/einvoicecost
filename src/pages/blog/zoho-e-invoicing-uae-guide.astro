const title = 'ZOHO BOOKS E-INVOICING UAE 2027: COSTS, SETUP AND EXAMPLES';
const description =
  'Zoho Books UAE e-invoicing for 2027: plan and pack prices, a 5-step setup and real examples for contractors, distributors, traders and service firms.';

const wa = (t: string) => `https://wa.me/${WA}?text=${encodeURIComponent(t)}`;
const ctaWa = wa('Hi, I use Zoho Books and read your guide. I would like you to set up e-invoicing.');
const setupWa = wa('Hi, I use Zoho Books and read your guide. I would like you to set up e-invoicing.');

type FAQ = { q: string; a: string };

const faqs: FAQ[] = [
  { q: "Is Zoho Books an accredited service provider (ASP) in the UAE?", a: "Yes. Zoho Software Trading LLC is on the Ministry of Finance list of accredited service providers, with accreditation number 121988. Zoho Books users appoint Zoho on EmaraTax. They do not need another provider." },
  { q: "How much does Zoho Books e-invoicing cost in the UAE?", a: "You pay for two things. First, a Zoho Books plan at Professional level or higher, which starts at AED 90 a month on yearly billing (AED 1,080 a year). Second, e-invoicing packs. The first 100 transactions are free, once. After that, a pack of 1,000 costs AED 330. All prices exclude 5% VAT." },
  { q: "Which Zoho Books plan do I need for UAE e-invoicing?", a: "You need the Professional plan or higher. The Free and Standard plans do not include e-invoicing. Professional costs AED 90 a month on yearly billing and AED 129 a month on monthly billing." },
  { q: "How many free e-invoices does Zoho Books give me?", a: "The first 100 e-invoicing transactions are free. This is a one-time allowance, not a yearly one. Once you use the 100, you buy packs." },
  { q: "What do Zoho e-invoicing packs cost?", a: "A pack of 100 costs AED 41. A pack of 500 costs AED 185. A pack of 1,000 costs AED 330. A pack of 5,000 costs AED 1,500. A pack of 10,000 costs AED 2,700. Larger packs cost AED 11,500 for 50,000 and AED 20,000 for 100,000. Packs are one-time purchases and exclude 5% VAT." },
  { q: "Do Zoho e-invoicing packs expire?", a: "Zoho partner material says unused transactions stay valid as long as your Zoho organisation stays the same. Confirm this with Zoho for your own account before you buy a large pack." },
  { q: "What counts as one e-invoicing transaction in Zoho Books?", a: "Each e-invoice you send is one transaction. Each credit note you send is also one. Zoho partner material says received bills and credit notes may count too, so confirm with Zoho. Sales to consumers (B2C) are outside e-invoicing for now." },
  { q: "How do I set up e-invoicing in Zoho Books?", a: "Check your plan and your data. Enter your business details in Zoho Books under Settings, E-Invoicing. Select Zoho Software Trading LLC as your ASP on the EmaraTax portal. Return to Zoho Books and click Verify & Complete Setup. Then fix any data gaps and send one test invoice and one test credit note." },
  { q: "How long does Zoho Books e-invoicing setup take?", a: "Most businesses finish the setup in a few hours. The forms are quick. The slow part is cleaning customer and item data, such as missing customer TRNs, missing VAT codes and unclear units." },
  { q: "What is my Peppol ID in Zoho Books?", a: "Your Peppol participant ID is 0235 followed by your 10-digit TIN. The TIN is usually the first 10 digits of your 15-digit TRN. Zoho creates the ID when you complete the setup." },
  { q: "Can I edit a Zoho Books invoice after I send it as an e-invoice?", a: "No. Once an e-invoice is sent, you cannot edit or delete it. You issue a credit note to correct it, and a new e-invoice if the sale must be billed again. Check the invoice before you send it." },
  { q: "Do walk-in retail sales need e-invoices in the UAE?", a: "Not for now. Sales to consumers (B2C) are outside the e-invoicing system. But a walk-in buyer who is a business, and who gives you a company TRN, is a B2B customer. That sale needs an e-invoice once your phase starts." },
  { q: "When is the e-invoicing deadline for Zoho Books users?", a: "It is the same as for every business. With revenue under AED 50 million, appoint an ASP by 31 March 2027 and go live on 1 July 2027. With revenue of AED 50 million or more, the appointment date was 30 October 2026 and go-live is 1 January 2027. Government entities go live on 1 October 2027." },
  { q: "What is the penalty for missing the e-invoicing deadline?", a: "Under Cabinet Decision No. 106 of 2025, not appointing an ASP on time costs AED 5,000 for each month. After go-live, each invoice or credit note not issued electronically can cost AED 100, up to AED 5,000 a month for each type." },
  { q: "How does a contractor bill retention in Zoho Books?", a: "The progress e-invoice can cover the net amount after retention is held back. When the retention is released, you issue a separate e-invoice for that amount. Keep retention outside the invoice total in Zoho Books, and test one progress invoice and one retention release before go-live." },
  { q: "How do I handle returns and damaged goods in Zoho Books?", a: "Issue a credit note from the original invoice. The credit note links to the invoice and goes through Peppol like any other e-invoice document. It uses one transaction. If the sale needs to be billed again, send a new e-invoice." },
  { q: "I am on the Free or Standard plan. Do I have to upgrade?", a: "Zoho's built-in e-invoicing needs Professional or higher. Moving from Standard to Professional costs AED 360 more a year on yearly billing. An outside ASP is another route, but it adds a second system and a second bill. For most firms, upgrading is simpler." },
  { q: "Can einvoicecost.ae set up Zoho Books e-invoicing for me?", a: `Yes. We do the full setup for ${aed(P.help)}, one time. This covers a plan check, data clean-up, your EmaraTax appointment, a test invoice and credit note, and fixes for rejected invoices. Or set it up yourself for free with the steps in this guide.` },
];

const breadcrumbs = [
  { name: 'Home', url: 'https://einvoicecost.ae/' },
  { name: 'Blog', url: 'https://einvoicecost.ae/blog' },
  { name: 'Zoho Books e-invoicing UAE', url: URL },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: PUBLISHED,
