  ['who', 'Which small traders must use it?'], ['channel', 'How your sales channel affects you'], ['software', 'Accounting and POS software'],
  ['choose', 'Which software to choose'], ['vat', 'Does VAT registration matter?'], ['how', 'How the system works'], ['asp', 'What is an ASP?'],
  ['penalties', 'Penalties'], ['cost', 'How much it costs'], ['prepare', 'How to prepare'], ['first', 'What to do first'],
