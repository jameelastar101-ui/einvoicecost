const title = 'UAE E-INVOICING FOR SMALL TRADERS: 2027 DEADLINES & RULES';
const description =
  'UAE small traders: learn who must use e-invoicing, the 2027 deadlines, software options, costs and fines. Simple guide with real examples.';

const wa = (t: string) => `https://wa.me/${WA}?text=${encodeURIComponent(t)}`;
const ctaWa = wa('Hi, I read your e-invoicing guide for small traders. I use [software], about [number] invoices a year. Please send me my price.');

type FAQ = { q: string; a: string };

const faqs: FAQ[] = [
  { q: "When does mandatory e-invoicing start for small traders?", a: "Small traders with annual revenue below AED 50 million must appoint an ASP by 31 March 2027. Mandatory e-invoicing for small traders starts on 1 July 2027." },
  { q: "Does a small trader need e-invoicing if the business earns less than AED 375,000?", a: "Yes, a small trader may still need it. The VAT registration threshold and e-invoicing are separate matters. If a small trader issues B2B or B2G invoices, it may need to comply even if it is not registered for VAT." },
  { q: "Does a small trader need to register for VAT before using e-invoicing?", a: "No. VAT registration is not a general condition for e-invoicing. Non-VAT-registered small traders can also fall within the rules." },
  { q: "Can a small trader continue sending PDF invoices?", a: "PDF invoices alone will not meet the structured e-invoicing rules for B2B and B2G transactions once mandatory use begins. Small traders will need a compatible electronic invoicing system." },
  { q: "Do small traders need to change their POS systems?", a: "Not necessarily. If a small trader sells only to individual consumers, its normal retail receipts may not need to change under the current B2C exclusion. But if a small trader sells to companies, it should check whether its POS can handle structured B2B invoices." },
  { q: "Does a small trader need an ASP if it only sells to individual customers?", a: "A small trader may not need to send e-invoices for B2C sales. But it should think about how it will receive structured e-invoices from suppliers. Small traders should check the requirements that apply to their business." },
  { q: "Can small traders use Excel to prepare e-invoices?", a: "Excel can help small traders manage business data. But it cannot send structured e-invoices through the Peppol network on its own. Small traders will need an ASP. Some ASPs let Excel users upload a ready template, so they do not have to change their software." },
  { q: "Does e-invoicing replace VAT returns for small traders?", a: "No. E-invoicing does not replace regular VAT return filing. VAT-registered small traders must keep meeting their VAT reporting duties." },
  { q: "Can small traders use the same software to send and receive e-invoices?", a: "This depends on the software and ASP integration. Before choosing, small traders should confirm that the software supports both outgoing and incoming e-invoices." },
  { q: "What happens if a small trader sells to both businesses and individuals?", a: "A small trader must identify which transactions fall within the e-invoicing rules. For example, a stationery shop can keep issuing normal consumer receipts. It sends structured e-invoices only for company sales." },
];

const breadcrumbs = [
  { name: 'Home', url: 'https://einvoicecost.ae/' },
  { name: 'Blog', url: 'https://einvoicecost.ae/blog' },
  { name: 'UAE e-invoicing for small traders', url: URL },
];

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: PUBLISHED,
  dateModified: UPDATED_ISO,
  author: { '@type': 'Organization', name: 'einvoicecost.ae', url: 'https://einvoicecost.ae' },
  publisher: { '@type': 'Organization', name: 'einvoicecost.ae', url: 'https://einvoicecost.ae' },
