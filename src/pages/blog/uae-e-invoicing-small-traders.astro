import '../../styles/blog.css';
import { PRICES as P, WA, fmt, aed, price } from '../../config/prices.js';

/** Update these whenever prices or rules change. */
const PUBLISHED = '2026-11-13';
const UPDATED_ISO = '2026-11-13';
const UPDATED = '13 November 2026';

const URL = 'https://einvoicecost.ae/blog/uae-e-invoicing-small-traders';
const N0 = P.feeCovered;
const first = (k: string, n = N0) => price(k, n).firstYear;
