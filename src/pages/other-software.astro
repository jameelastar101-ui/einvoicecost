---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/guide.css';
import PriceBox from '../components/PriceBox.astro';
import PriceTable from '../components/PriceTable.astro';
import { PRICES, PRICES_CHECKED, fmt, aed, invoiceFee, firstYearText, everyYearText, connectorText } from '../config/prices.js';

const title = "E-Invoicing UAE: Xero, Odoo, Sage, SAP & Other Software";
const fy = firstYearText('other');
const ny = everyYearText();
const description = `Does your software need an e-invoicing ASP in the UAE? Xero, Odoo, Sage, SAP, Oracle, Dynamics, ERPNext, BUSY and more. AED ${fy} first year plus a connector price on WhatsApp.`;
const faqs = [
  {
    "q": "Does Xero need an ASP in the UAE?",
    "a": "Yes. Xero is not an accredited service provider itself, so it needs an ASP, a connection and setup before it can send UAE e-invoices. We handle all of it at our standard prices. Message us on WhatsApp for the connector price."
  },
  {
    "q": "Does my accounting software need an ASP?",
    "a": "If your software company is not an accredited ASP, yes. Most accounting and ERP software in the UAE is not an ASP, so it must be connected to one. Zoho Books, TallyPrime and Wafeq are ASPs themselves."
  },
  {
    "q": "How do I know if my software is an ASP?",
    "a": "Check the Ministry of Finance list of accredited service providers. If your software company is on it, you can appoint it on EmaraTax directly."
  },
  {
    "q": "How much does Odoo, Sage or SAP e-invoicing cost?",
    "a": `Everything except the connector has a fixed price: AED ${fy} in the first year for up to 500 invoices, plus the connector, then AED ${ny} a year. The connector price depends on your software, version and how it connects. WhatsApp us your software name and invoice count and we send the connector price, usually the same day.`
  },
  {
    "q": "My software is not listed. Can you still help?",
    "a": "Yes. Tell us your software name and send us a WhatsApp message. Most software can connect through an API, a desktop agent or an Excel upload, and we will help you."
  },
  {
    "q": "What is the e-invoicing deadline for Odoo, Sage and SAP users?",
    "a": "The same as every business. Businesses under AED 50 million revenue must appoint an ASP by 31 March 2027 and go live on 1 July 2027. The fine for appointing late is AED 5,000 a month."
  }
];
const breadcrumbs = [
  {
    "name": "Home",
    "url": "https://einvoicecost.ae/"
  },
  {
    "name": "Other software",
    "url": "https://einvoicecost.ae/other-software"
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://einvoicecost.ae/other-software"
  ogType="article"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <div class="band-navy">
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">einvoicecost<span>.ae</span></a>
        <div class="top-right">
          <a class="link" href="/#compare">Compare all software</a>
          <a class="btn-top" id="topWa" href="https://wa.me/971508759256" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp</a>
        </div>
      </header>
      <nav class="gnav" aria-label="Software guides"><span class="gl">Guides</span><div class="gscroll"><a href="/quickbooks-online">QuickBooks Online</a><a href="/quickbooks-desktop">QuickBooks Desktop</a><a href="/excel">Excel</a><a href="/zoho-books">Zoho Books</a><a href="/tally">Tally</a><a href="/wafeq">Wafeq</a><a href="/other-software" aria-current="page">Other software</a><a href="/switch-accounting-software">Switch software</a></div></nav>
      <p class="crumb"><a href="/">Home</a> › Other software</p>
      <p class="eyebrow">All other software · UAE e-invoicing guide</p>
      <h1>E-invoicing for other accounting software in the UAE</h1>
      <div class="answer">
        <p class="eyebrow">Quick answer</p>
        <p>Most accounting and ERP software in the UAE is <b>not an ASP itself</b>, so it must be connected to an accredited provider. Zoho Books, TallyPrime and Wafeq are the main exceptions.</p><p>Not on the list? Tell us your software name on WhatsApp and we will help you. <b>We handle the whole setup.</b></p>
        <div class="facts"><div><p class="k">Software covered</p><p class="v">15+</p></div><div><p class="k">Price</p><p class="v">AED {fy} + connector</p></div><div><p class="k">Our reply</p><p class="v">Same day</p></div></div>
      </div>
    </div>
  </div>
  <main class="wrap">
  
    <section id="price-box">
      <h2>Same price for every software</h2>
      <p class="sub">Whatever software you use, you pay the same fixed prices below. The only part that changes is the auto-send connector, because every software connects in a different way.</p>
      <PriceBox sw="other" />
      <p class="small"><a href="/blog/uae-e-invoicing-cost#formula">See how the price is calculated →</a></p>
      <p class="small">Above 500 invoices, you pay for your exact invoice count, with no slabs or brackets. Invoices you receive from suppliers are free. All prices in AED, excluding 5% VAT.</p>
    </section>
    <section id="cost">
      <h2>Which software needs an ASP?</h2>
      <div class="notlisted"><p><b>Your software not on the list below?</b> Tell us your software name and send us a WhatsApp message. We will help you.</p><a class="btn-wa" href="https://wa.me/971508759256?text=Hi%2C%20my%20software%20is%20not%20on%20your%20list.%20My%20software%20is%3A%20" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> WhatsApp us</a></div>
      <p class="sub">Find your software below. Every connection is different, so WhatsApp us for the <b>connector price</b>. Everything else is the same fixed price for all software. We reply the same day.</p>
      <div class="cards"><div class="card"><span class="badge need">Needs an ASP</span><h3>Xero</h3><p>Needs an accredited ASP, a connection and setup before it can send UAE e-invoices.</p><p class="from"><a data-sw="Xero" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Odoo</h3><p>Connects through an app module, cloud or on-premise.</p><p class="from"><a data-sw="Odoo" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Sage 50, 300 and X3</h3><p>Connects through a connector or an automated export.</p><p class="from"><a data-sw="Sage 50, 300 and X3" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Microsoft Dynamics 365</h3><p>Connects through an integration project.</p><p class="from"><a data-sw="Microsoft Dynamics 365" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>ERPNext</h3><p>Connects through a Frappe connector, cloud or self-hosted.</p><p class="from"><a data-sw="ERPNext" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge check">Check first</span><h3>Focus</h3><p>Focus offers its own e-invoicing product. Check whether it covers you, or connect through our partner.</p><p class="from"><a data-sw="Focus" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge check">Check first</span><h3>Daftra</h3><p>Daftra offers UAE e-invoicing. Check whether it acts as your ASP before paying for another.</p><p class="from"><a data-sw="Daftra" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>BUSY</h3><p>A desktop agent picks up invoices from an export folder.</p><p class="from"><a data-sw="BUSY" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Marg</h3><p>Connects through a desktop agent.</p><p class="from"><a data-sw="Marg" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Opera</h3><p>Connects through a desktop agent and CSV export.</p><p class="from"><a data-sw="Opera" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>SAP</h3><p>Enterprise integration project.</p><p class="from"><a data-sw="SAP" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Oracle NetSuite and Fusion</h3><p>Enterprise integration project.</p><p class="from"><a data-sw="Oracle NetSuite and Fusion" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Epicor, Infor and IFS</h3><p>Integration through their APIs.</p><p class="from"><a data-sw="Epicor, Infor and IFS" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>PACT</h3><p>Integration through its API.</p><p class="from"><a data-sw="PACT" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge need">Needs an ASP</span><h3>Custom or in-house ERP</h3><p>Connects through an API set up for your system.</p><p class="from"><a data-sw="Custom or in-house ERP" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div><div class="card"><span class="badge check">Check first</span><h3>Wave</h3><p>Message us and we'll tell you the best way to handle UAE e-invoicing with Wave.</p><p class="from"><a data-sw="Wave" href="#" target="_blank" rel="noopener">WhatsApp us for the connector price →</a></p></div></div>
      <p class="small">Using Zoho Books, TallyPrime or Wafeq? E-invoicing is built in: see <a href="/zoho-books">Zoho Books</a>, <a href="/tally">Tally</a> or <a href="/wafeq">Wafeq</a>.</p>
    </section>
    <section id="price">
      <h2>Get your connector price on WhatsApp</h2>
      <p class="sub">Fill in three details and send them on WhatsApp. We reply with the connector price, usually the same day.</p>
      <form class="form" id="priceForm">
        <label>Your software<input id="fSw" type="text" placeholder="e.g. Odoo 16"></label>
        <label>Invoices per year<input id="fInv" type="text" inputmode="numeric" placeholder="e.g. 2,000"></label>
        <label>Your name<input id="fName" type="text" placeholder="Optional"></label>
        <button class="btn-wa" type="submit"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Send on WhatsApp</button>
      </form>
    </section>
    <section id="steps">
      <h2>How we set up e-invoicing for other software</h2>
      <ol class="steps5"><li><div><div class="st-head"><h3>Tell us your software</h3></div><p>Message us your software name, version and how many invoices you send a year.</p></div></li><li><div><div class="st-head"><h3>We check how it connects</h3><span class="tag us">We handle it</span></div><p>We confirm whether your software is an ASP itself, or which connector, agent or upload route it needs.</p></div></li><li><div><div class="st-head"><h3>You get the connector price</h3><span class="tag us">We handle it</span></div><p>Everything else is already fixed. We send the connector price on WhatsApp before any work starts.</p></div></li><li><div><div class="st-head"><h3>We set it up</h3><span class="tag us">We handle it</span></div><p>We appoint the ASP on EmaraTax for you, set up the connection and match your VAT codes and items to the UAE format.</p></div></li><li><div><div class="st-head"><h3>Test and go live</h3><span class="tag us">We handle it</span></div><p>We send test invoices and a credit note, fix anything rejected, then switch it on. If an invoice is rejected later, we fix it.</p></div></li></ol>
    </section>
    <section>
      <h2>Things to know before you start</h2>
      <ul class="warn"><li><b>Check if your software is an ASP.</b> If your software company is on the Ministry of Finance list of accredited providers, you can appoint it directly and may not need another ASP.</li><li><b>A PDF invoice is not a UAE e-invoice.</b> Emailing a PDF will not count for invoices in scope. They must go through an accredited ASP in the structured format.</li><li><b>You appoint one ASP.</b> The same ASP handles the e-invoices you send and the ones you receive.</li></ul>
      <p class="callout">Thinking of moving to Zoho Books, Tally or Wafeq instead? <a href="/switch-accounting-software">We move your data →</a></p>
    </section>
    
    <section class="sources"><h2>Sources</h2><ul><li><a href="https://mof.gov.ae/en/about-us/initiatives/einvoicing/" target="_blank" rel="noopener">UAE Ministry of Finance: e-invoicing</a></li></ul><p class="small">Prices and rules checked against these sources on {PRICES_CHECKED}. We update this page when they change.</p></section>
    <section>
      <h2>What is the e-invoicing deadline for Other software users?</h2>
      <p class="sub">Businesses under AED 50 million revenue must appoint an ASP by <b>31 March 2027</b> and go live on <b>1 July 2027</b>. The fine for appointing late is <b>AED 5,000 a month</b>. After go-live, each invoice not issued electronically can be fined AED 100, up to AED 5,000 a month. Businesses over AED 50 million had to appoint by 30 October 2026 and go live on 1 January 2027.</p>
    </section>
    <section>
      <h2>Other software e-invoicing: common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.html ?? f.a} /></details>
        ))}
      </div>
    </section>
    <section class="final">
      <div><h2>Not sure about your software?</h2><p class="sub">Send us the name and your invoice count. We reply with the connector price, usually the same day.</p></div>
      <a class="btn-wa" id="finalWa" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg> Get my connector price on WhatsApp</a>
    </section>
    <section>
      <h2>E-invoicing cost for other software</h2>
      <div class="more"><a href="/quickbooks-online">QuickBooks Online<span>Needs an ASP</span></a><a href="/quickbooks-desktop">QuickBooks Desktop<span>Needs an ASP</span></a><a href="/excel">Excel / no software<span>Needs an ASP</span></a><a href="/zoho-books">Zoho Books<span>Built-in ASP</span></a><a href="/tally">Tally Prime<span>Built-in ASP</span></a><a href="/wafeq">Wafeq<span>Built-in ASP</span></a><a href="/#compare">Compare all<span>Side by side</span></a></div>
    </section>
    <SiteFooter />
  </main>
  <div class="dock">
    <div class="row">
      <p class="fy cta" id="dockFy">Need e-invoice support?</p>
      <a class="btn-wa" id="dockWa" href="#" target="_blank" rel="noopener">WhatsApp Now</a>
    </div>
  </div>
  <script>
    import '../scripts/other-software.js';
  </script>
</BaseLayout>
